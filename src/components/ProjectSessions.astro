---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import FloorPlanProcess from "./FloorPlanProcess.astro";
import ViewerIcon from "./ViewerIcon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const frameworkLinesBySlug: Record<string, string[]> =
  locale === "zh"
    ? {
        "floor-plan-reconstruction": ["计算机", "视觉"],
        "robotic-video-intelligence": ["产品/系统", "设计"],
        "lookx-generative-ai": ["生成式", "模型"],
        "multimodal-asset-search": ["云原生", "架构"],
        "vision-agent": ["智能体", "架构"],
      }
    : {
        "floor-plan-reconstruction": ["Computer", "Vision"],
        "robotic-video-intelligence": ["System", "Design"],
        "lookx-generative-ai": ["Generative", "Models"],
        "multimodal-asset-search": ["Cloud", "Architecture"],
        "vision-agent": ["Agent", "Harness"],
      };
const titleLinesBySlug: Record<string, string[]> =
  locale === "zh"
    ? {
        "floor-plan-reconstruction": ["户型图", "矢量重建"],
        "robotic-video-intelligence": ["实时直播流", "视觉分析"],
        "lookx-generative-ai": ["建筑模型", "AI渲染"],
        "multimodal-asset-search": ["多模态", "图片检索"],
        "vision-agent": ["实时视觉", "Agent"],
      }
    : {
        "floor-plan-reconstruction": ["Raster-to-Vector", "Floor Plans"],
        "robotic-video-intelligence": ["Robotic Video", "Intelligence"],
        "lookx-generative-ai": ["Architectural", "AI Rendering"],
        "multimodal-asset-search": ["Multimodal", "Image Search"],
        "vision-agent": ["Realtime", "Visual Agent"],
      };
const copy =
  locale === "zh"
    ? {
        title: "项目展映",
        previous: "上一个项目",
        next: "下一个项目",
        watch: "观看项目细节",
      }
    : {
        title: "Project sessions",
        previous: "Previous project",
        next: "Next project",
        watch: "Watch the story",
      };
---

<div class="sessions-view is-hydrating" data-sessions-view tabindex="0" aria-label={copy.title}>
  <div class="sessions-backgrounds" aria-hidden="true">
    <canvas class="sessions-neat-gradient" data-sessions-neat-gradient></canvas>
    {projects.map((project, index) => (
      <div
        class={`sessions-background accent-${project.data.accent} project-${project.data.slug}${index === 0 ? " is-active" : ""}`}
        data-session-background
      ></div>
    ))}
  </div>
  <div class="sessions-shade" aria-hidden="true"></div>

  <nav class="sessions-index" aria-label={copy.title}>
    <ol>
      {projects.map((project, index) => (
        <li data-session-index-item class={index === 0 ? "is-active" : ""}>
          <button type="button" data-session-select={index}>
            <strong>
              {(frameworkLinesBySlug[project.data.slug] ?? [project.data.framework]).map((line) => (
                <span>{line}</span>
              ))}
            </strong>
          </button>
        </li>
      ))}
    </ol>
  </nav>

  <div class="sessions-project-stage">
    <div class="sessions-visuals" aria-live="polite">
      {projects.map((project, index) => (
        <figure
          class={`session-visual accent-${project.data.accent}${index === 0 ? " is-active" : ""}`}
          data-session-visual
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <div class="session-visual-frame">
            {project.data.sessionVideo ? (
              <video
                src={project.data.sessionVideo}
                poster={project.data.sessionPoster ?? project.data.sessionVisual}
                aria-label={project.data.diagramAlt}
                autoplay
                muted
                loop
                playsinline
                preload="auto"
              ></video>
            ) : project.data.slug === "floor-plan-reconstruction" ? (
              <FloorPlanProcess alt={project.data.diagramAlt} />
            ) : (
              <img src={project.data.sessionVisual} alt={project.data.diagramAlt} />
            )}
          </div>
        </figure>
      ))}
    </div>

    <div class="sessions-copy-stack">
      <div class="sessions-details">
        {projects.map((project, index) => (
          <article
            class={`session-detail${index === 0 ? " is-active" : ""}`}
            data-session-detail
            data-slug={project.data.slug}
            aria-hidden={index === 0 ? "false" : "true"}
            inert={index === 0 ? undefined : true}
          >
            <h1 aria-label={project.data.sessionTitle}>
              {(titleLinesBySlug[project.data.slug] ?? [project.data.sessionTitle]).map((line) => (
                <span>{line}</span>
              ))}
            </h1>
            <p class="session-summary">{project.data.sessionDescription}</p>
            <button type="button" class="session-watch" data-session-watch>
              <span>{copy.watch}</span>
            </button>
          </article>
        ))}
      </div>

      <div class="sessions-navigation">
        <button type="button" data-session-previous aria-label={copy.previous}>
          <ViewerIcon name="up" size={21} />
        </button>
        <button type="button" data-session-next aria-label={copy.next}>
          <ViewerIcon name="down" size={21} />
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ projectSlugs: projects.map((project) => project.data.slug) }}>
  const sessionsView = document.querySelector("[data-sessions-view]");

  if (sessionsView instanceof HTMLElement) {
    const indexItems = [...sessionsView.querySelectorAll("[data-session-index-item]")];
    const visuals = [...sessionsView.querySelectorAll("[data-session-visual]")];
    const details = [...sessionsView.querySelectorAll("[data-session-detail]")];
    const backgrounds = [...sessionsView.querySelectorAll("[data-session-background]")];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let activeIndex = 0;
    let wheelLocked = false;

    const circularDistance = (index, center) => {
      const count = projectSlugs.length;
      let distance = (index - center) % count;
      if (distance > count / 2) distance -= count;
      if (distance < -count / 2) distance += count;
      return distance;
    };

    const showProject = (nextIndex, announce = true) => {
      activeIndex = (nextIndex + projectSlugs.length) % projectSlugs.length;
      const collections = [indexItems, visuals, details, backgrounds];

      collections.forEach((nodes) => {
        nodes.forEach((node, index) => {
          const distance = circularDistance(index, activeIndex);
          const active = index === activeIndex;
          node.classList.toggle("is-active", active);
          node.classList.toggle("is-previous", distance === -1);
          node.classList.toggle("is-next", distance === 1);
          node.classList.toggle("is-far", Math.abs(distance) > 1);
          node.style.setProperty("--session-distance", String(distance));
          node.style.setProperty("--session-depth", String(Math.abs(distance)));
          node.style.zIndex = String(projectSlugs.length - Math.abs(distance));
          if (node.matches("[data-session-detail], [data-session-visual]")) {
            node.setAttribute("aria-hidden", active ? "false" : "true");
          }
          if (node.matches("[data-session-detail]")) node.inert = !active;
        });
      });

      sessionsView.querySelectorAll("video").forEach((video) => {
        const owner = video.closest("[data-session-visual], [data-session-background]");
        const ownerIndex = owner?.matches("[data-session-visual]")
          ? visuals.indexOf(owner)
          : backgrounds.indexOf(owner);
        if (ownerIndex === activeIndex && !reducedMotion) {
          video.play().catch(() => {});
          return;
        }
        video.pause();
      });

      if (window.matchMedia("(max-width: 760px)").matches) {
        indexItems[activeIndex]?.scrollIntoView({
          behavior: reducedMotion ? "auto" : "smooth",
          block: "nearest",
          inline: "center",
        });
      }

      if (announce) {
        window.dispatchEvent(
          new CustomEvent("portfolio:project-change", {
            detail: { slug: projectSlugs[activeIndex], source: "sessions" },
          }),
        );
      }
    };

    sessionsView.querySelectorAll("[data-session-select]").forEach((button) => {
      button.addEventListener("click", () => {
        showProject(Number(button.getAttribute("data-session-select")));
      });
    });
    sessionsView.querySelectorAll("[data-session-previous]").forEach((button) => {
      button.addEventListener("click", () => showProject(activeIndex - 1));
    });
    sessionsView.querySelectorAll("[data-session-next]").forEach((button) => {
      button.addEventListener("click", () => showProject(activeIndex + 1));
    });
    sessionsView.querySelectorAll("[data-session-watch]").forEach((button) => {
      button.addEventListener("click", () => {
        window.dispatchEvent(
          new CustomEvent("portfolio:open-deck", {
            detail: { slug: projectSlugs[activeIndex] },
          }),
        );
      });
    });
    sessionsView.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaY) < 18 || wheelLocked) return;
        event.preventDefault();
        wheelLocked = true;
        showProject(activeIndex + (event.deltaY > 0 ? 1 : -1));
        window.setTimeout(() => {
          wheelLocked = false;
        }, reducedMotion ? 120 : 650);
      },
      { passive: false },
    );

    sessionsView.addEventListener("keydown", (event) => {
      if (event.key === "ArrowUp") {
        event.preventDefault();
        showProject(activeIndex - 1);
      }
      if (event.key === "ArrowDown") {
        event.preventDefault();
        showProject(activeIndex + 1);
      }
    });

    window.addEventListener("portfolio:navigate", (event) => {
      const index = projectSlugs.indexOf(event.detail?.slug);
      if (index >= 0) showProject(index, false);
    });
    window.addEventListener("portfolio:project-change", (event) => {
      if (event.detail?.source === "sessions") return;
      const index = projectSlugs.indexOf(event.detail?.slug);
      if (index >= 0) showProject(index, false);
    });

    const initialSlug = decodeURIComponent(window.location.hash.slice(1));
    const initialIndex = projectSlugs.indexOf(initialSlug);
    showProject(initialIndex >= 0 ? initialIndex : 0, false);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        sessionsView.classList.remove("is-hydrating");
      });
    });
  }
</script>

<script>
  import { NeatGradient } from "@firecms/neat";

  const gradientCanvas = document.querySelector("[data-sessions-neat-gradient]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const neatPalettes: Record<string, string[]> = {
    "vision-agent": ["#846AFF", "#001129", "#0F0025", "#06100D", "#50FFB9"],
    "robotic-video-intelligence": ["#50FFB9", "#04120D", "#0A1C12", "#112506", "#ABEE6A"],
    "multimodal-asset-search": ["#ABEE6A", "#001129", "#06142B", "#003381", "#2C95FF"],
    "lookx-generative-ai": ["#2C95FF", "#14080A", "#1D1207", "#4F2100", "#FFB22D"],
    "floor-plan-reconstruction": ["#FFB22D", "#14080A", "#21100A", "#381007", "#846AFF"],
  };

  const toNeatColors = (colors: string[]) => colors.map((color: string) => ({ color, enabled: true }));

  if (gradientCanvas instanceof HTMLCanvasElement && !reducedMotion) {
    try {
      const gradient = new NeatGradient({
        ref: gradientCanvas,
        colors: toNeatColors(neatPalettes[decodeURIComponent(window.location.hash.slice(1))] ?? neatPalettes["vision-agent"]),
        speed: 0.85,
        horizontalPressure: 4,
        verticalPressure: 4,
        waveFrequencyX: 3,
        waveFrequencyY: 2,
        waveAmplitude: 1,
        shadows: 2,
        highlights: 2,
        colorBrightness: 0.82,
        colorSaturation: -0.55,
        wireframe: false,
        colorBlending: 7,
        backgroundColor: "#010101",
        backgroundAlpha: 1,
        grainScale: 2,
        grainSparsity: 0,
        grainIntensity: 0,
        grainSpeed: 1,
        resolution: 0.42,
        yOffset: 38,
        yOffsetWaveMultiplier: 2.2,
        yOffsetColorMultiplier: 2.5,
        yOffsetFlowMultiplier: 2.8,
        flowDistortionA: 0.4,
        flowDistortionB: 3,
        flowScale: 3.3,
        flowEase: 0.53,
        flowEnabled: false,
        enableProceduralTexture: false,
        transparentTextureVoid: false,
        textureVoidLikelihood: 0.06,
        textureVoidWidthMin: 10,
        textureVoidWidthMax: 500,
        textureBandDensity: 0.8,
        textureColorBlending: 0.06,
        textureSeed: 333,
        textureEase: 0.68,
        proceduralBackgroundColor: "#003FFF",
        textureShapeTriangles: 20,
        textureShapeCircles: 15,
        textureShapeBars: 15,
        textureShapeSquiggles: 10,
        domainWarpEnabled: false,
        domainWarpIntensity: 0,
        domainWarpScale: 3,
        vignetteIntensity: 0,
        vignetteRadius: 0.8,
        fresnelEnabled: false,
        fresnelPower: 2,
        fresnelIntensity: 0.5,
        fresnelColor: "#FFFFFF",
        iridescenceEnabled: false,
        iridescenceIntensity: 0.5,
        iridescenceSpeed: 1,
        bloomIntensity: 0,
        bloomThreshold: 0.7,
        chromaticAberration: 0,
        shapeType: "plane",
        shapeRotationX: 0,
        shapeRotationY: 0,
        shapeRotationZ: 0,
        shapeAutoRotateSpeedX: 0,
        shapeAutoRotateSpeedY: 0,
        sphereRadius: 15,
        torusRadius: 15,
        torusTube: 5,
        cylinderRadius: 10,
        cylinderHeight: 40,
        planeBend: 0,
        planeTwist: 0,
        silhouetteFade: 0.25,
        cylinderFade: 0.08,
        ribbonFade: 0.05,
        flatShading: true,
        cameraLock: true,
        cameraX: 0,
        cameraY: 0,
        cameraZ: 0,
        cameraRotationX: 0,
        cameraRotationY: 0,
        cameraRotationZ: 0,
        cameraZoom: 1,
      });

      window.addEventListener("portfolio:project-change", (event: Event) => {
        if (!(event instanceof CustomEvent)) return;
        const slug = event.detail?.slug;
        if (typeof slug === "string" && slug in neatPalettes) {
          gradient.colors = toNeatColors(neatPalettes[slug]);
        }
      });
      window.addEventListener("pagehide", () => gradient.destroy(), { once: true });
    } catch {
      gradientCanvas.hidden = true;
    }
  }
</script>

<style>
  .sessions-view {
    --session-ink: #f3f0e8;
    --session-index-face: var(--sans);
    --session-title-face: var(--serif);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(42rem, 1.72fr);
    column-gap: clamp(1.5rem, 3vw, 3.75rem);
    align-items: center;
    min-height: calc(100svh - 5.4rem);
    padding: clamp(5.5rem, 9vh, 8rem) clamp(2rem, 3.4vw, 4.25rem) clamp(3rem, 6vh, 5rem);
    overflow: hidden;
    color: var(--session-ink);
    background: #101514;
    outline: none;
  }

  .sessions-view.is-hydrating *,
  .sessions-view.is-hydrating *::before,
  .sessions-view.is-hydrating *::after {
    transition: none !important;
    animation-duration: 0.001ms !important;
    animation-delay: 0s !important;
  }

  .sessions-backgrounds,
  .sessions-background,
  .sessions-shade {
    position: absolute;
    inset: 0;
  }

  .sessions-backgrounds {
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .sessions-neat-gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    opacity: 0.34;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .sessions-background {
    --session-accent: #d58b6c;
    --session-base-1: #101514;
    --session-base-2: #070909;
    --session-corner-tr: rgba(255, 124, 82, 0.44);
    --session-corner-bl: rgba(255, 226, 148, 0.18);
    --session-glow-mid: rgba(255, 255, 255, 0.06);
    opacity: 0;
    overflow: hidden;
    z-index: 1;
    background:
      radial-gradient(circle at 82% 18%, var(--session-corner-tr), transparent 40%),
      radial-gradient(circle at 18% 82%, var(--session-corner-bl), transparent 48%),
      radial-gradient(circle at 50% 48%, var(--session-glow-mid), transparent 42%),
      linear-gradient(135deg, var(--session-base-1), var(--session-base-2));
    transition: opacity 520ms ease;
  }

  .sessions-background.accent-sage {
    --session-accent: #90a892;
  }

  .sessions-background.accent-blue {
    --session-accent: #7aa8b6;
  }

  .sessions-background.accent-gold {
    --session-accent: #d5aa58;
  }

  .sessions-background.project-vision-agent {
    --session-base-1: #0a1230;
    --session-base-2: #030506;
    --session-corner-tr: rgba(132, 106, 255, 0.46);
    --session-corner-bl: rgba(80, 255, 185, 0.28);
    --session-glow-mid: rgba(92, 174, 255, 0.12);
  }

  .sessions-background.project-robotic-video-intelligence {
    --session-base-1: #0b1812;
    --session-base-2: #030605;
    --session-corner-tr: rgba(80, 255, 185, 0.28);
    --session-corner-bl: rgba(171, 238, 106, 0.38);
    --session-glow-mid: rgba(255, 216, 112, 0.1);
  }

  .sessions-background.project-multimodal-asset-search {
    --session-base-1: #06142b;
    --session-base-2: #020509;
    --session-corner-tr: rgba(171, 238, 106, 0.26);
    --session-corner-bl: rgba(44, 149, 255, 0.52);
    --session-glow-mid: rgba(79, 255, 219, 0.12);
  }

  .sessions-background.project-lookx-generative-ai {
    --session-base-1: #1d1207;
    --session-base-2: #060403;
    --session-corner-tr: rgba(44, 149, 255, 0.28);
    --session-corner-bl: rgba(255, 178, 45, 0.48);
    --session-glow-mid: rgba(255, 89, 120, 0.1);
  }

  .sessions-background.project-floor-plan-reconstruction {
    --session-base-1: #21100a;
    --session-base-2: #070504;
    --session-corner-tr: rgba(255, 178, 45, 0.3);
    --session-corner-bl: rgba(132, 106, 255, 0.46);
    --session-glow-mid: rgba(255, 231, 155, 0.12);
  }

  .sessions-background::before,
  .sessions-background::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .sessions-background::before {
    inset: -18%;
    background:
      radial-gradient(circle at 70% 24%, var(--session-corner-tr), transparent 34%),
      radial-gradient(circle at 24% 76%, var(--session-corner-bl), transparent 42%),
      radial-gradient(circle at 52% 46%, var(--session-glow-mid), transparent 40%);
    opacity: 0.58;
    transform: translate3d(-1.5%, 1.5%, 0) scale(1.04);
    will-change: transform;
  }

  .sessions-background.is-active::before {
    animation: sessionGradientDrift 20s ease-in-out infinite alternate;
  }

  .sessions-background::after {
    inset: 0;
    background:
      linear-gradient(90deg, rgba(4, 6, 6, 0.68), rgba(4, 6, 6, 0.18) 48%, rgba(4, 6, 6, 0.46)),
      radial-gradient(circle at 58% 44%, transparent 0 22%, rgba(5, 7, 7, 0.18) 58%, rgba(5, 7, 7, 0.62) 100%);
  }

  .sessions-background.is-active {
    opacity: 1;
  }

  @keyframes sessionGradientDrift {
    0% {
      transform: translate3d(-1.5%, 1.5%, 0) scale(1.04);
    }

    100% {
      transform: translate3d(1.8%, -1.2%, 0) scale(1.08);
    }
  }

  .sessions-shade {
    z-index: 1;
    background:
      linear-gradient(rgba(4, 6, 6, 0.1), rgba(4, 6, 6, 0.3)),
      radial-gradient(circle at 50% 50%, transparent 0 44%, rgba(4, 6, 6, 0.34) 100%);
    pointer-events: none;
  }

  .sessions-index {
    position: relative;
    z-index: 3;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    grid-column: 1;
    grid-row: 1;
  }

  .sessions-project-stage {
    position: relative;
    z-index: 2;
    align-self: center;
    display: grid;
    grid-template-columns: minmax(20rem, 0.88fr) minmax(26rem, 1.12fr);
    align-items: stretch;
    gap: clamp(2rem, 3.4vw, 4.75rem);
    width: 100%;
    height: min(40rem, 74vh);
    grid-column: 2;
    grid-row: 1;
  }

  .sessions-index ol {
    position: relative;
    height: min(27rem, 56vh);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sessions-index li {
    position: absolute;
    top: 50%;
    width: 100%;
    opacity: 0;
    filter: blur(5px);
    transform: translateY(calc(-50% + var(--session-distance, 0) * 9.8rem)) scale(0.72);
    transform-origin: left center;
    transition:
      opacity 520ms ease,
      filter 520ms ease,
      transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sessions-view .sessions-index li.is-active {
    opacity: 1;
    filter: none;
    transform: translateY(-50%) scale(1);
  }

  .sessions-view .sessions-index li.is-previous,
  .sessions-view .sessions-index li.is-next {
    opacity: 0.25;
    filter: blur(2.5px);
  }

  .sessions-index li.is-far {
    pointer-events: none;
  }

  .sessions-index button {
    display: block;
    width: 100%;
    padding: 1rem 1rem 1rem 0;
    border: 0;
    color: inherit;
    text-align: left;
    background: transparent;
    cursor: pointer;
  }

  .sessions-index button strong {
    display: block;
    max-width: 9ch;
    font-family: var(--session-index-face);
    font-size: clamp(3.2rem, 5vw, 6.2rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .sessions-index button strong span {
    display: block;
  }

  .sessions-visuals {
    position: relative;
    z-index: 2;
    align-self: center;
    width: 100%;
    aspect-ratio: 1 / 0.74;
    perspective: 1100px;
    grid-column: 1;
  }

  .session-visual {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transform:
      translate3d(calc(var(--session-distance, 0) * -46%), calc(var(--session-distance, 0) * 58%), -180px)
      rotateX(calc(var(--session-distance, 0) * -4deg))
      rotateY(calc(var(--session-distance, 0) * 8deg))
      scale(0.92);
    transform-style: preserve-3d;
    transition:
      opacity 380ms ease,
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sessions-view .session-visual.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) rotateX(1.5deg) rotateY(-5deg) scale(1);
  }

  .sessions-view .session-visual.is-previous,
  .sessions-view .session-visual.is-next {
    opacity: 0.4;
    filter: blur(2px) saturate(0.72) brightness(0.72);
  }

  .session-visual.is-far {
    opacity: 0;
  }

  .session-visual-frame {
    --session-media-background: #e7e3d9;
    position: relative;
    width: min(100%, 32rem);
    aspect-ratio: 4 / 3;
