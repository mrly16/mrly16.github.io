---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import FloorPlanProcess from "./FloorPlanProcess.astro";
import ViewerIcon from "./ViewerIcon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const lowTrafficMode =
  import.meta.env.PUBLIC_LOW_TRAFFIC_MODE === "true" ||
  (import.meta.env.PUBLIC_LOW_TRAFFIC_MODE !== "false" && import.meta.env.DEV);
const frameworkLinesBySlug: Record<string, string[]> =
  locale === "zh"
    ? {
        "floor-plan-reconstruction": ["计算机", "视觉"],
        "robotic-video-intelligence": ["AI应用", "交付"],
        "lookx-generative-ai": ["生成式", "模型"],
        "multimodal-asset-search": ["云原生", "架构"],
        "vision-agent": ["智能体", "架构"],
      }
    : {
        "floor-plan-reconstruction": ["Computer", "Vision"],
        "robotic-video-intelligence": ["Applied AI", "Delivery"],
        "lookx-generative-ai": ["Generative", "Models"],
        "multimodal-asset-search": ["Cloud", "Architecture"],
        "vision-agent": ["Agent", "Harness"],
      };
const titleLinesBySlug: Record<string, string[]> =
  locale === "zh"
    ? {
        "floor-plan-reconstruction": ["户型图", "矢量重建"],
        "robotic-video-intelligence": ["AI 算法", "实地验证工具"],
        "lookx-generative-ai": ["建筑行业", "AI 产品"],
        "multimodal-asset-search": ["多模态", "图片检索"],
        "vision-agent": ["实时视觉", "Agent"],
      }
    : {
        "floor-plan-reconstruction": ["Raster-to-Vector", "Floor Plans"],
        "robotic-video-intelligence": ["Vision AI", "Validation"],
        "lookx-generative-ai": ["AI Product", "for Architecture"],
        "multimodal-asset-search": ["Multimodal", "Image Search"],
        "vision-agent": ["Realtime", "Visual Agent"],
      };
const copy =
  locale === "zh"
    ? {
        title: "项目展映",
        previous: "上一个项目",
        next: "下一个项目",
        watch: "查看案例",
      }
    : {
        title: "Project sessions",
        previous: "Previous project",
        next: "Next project",
        watch: "View case study",
      };

const sessionTitleLabel = (project: CollectionEntry<"projects">) => {
  const lines = titleLinesBySlug[project.data.slug];
  if (!lines) return project.data.sessionTitle;
  return locale === "zh" ? lines.join("") : lines.join(" ");
};
---

<div class="sessions-view is-hydrating" data-sessions-view tabindex="0" aria-label={copy.title}>
  <div class="sessions-backgrounds" aria-hidden="true">
    <canvas class="sessions-neat-gradient" data-sessions-neat-gradient></canvas>
    {projects.map((project, index) => (
      <div
        class={`sessions-background accent-${project.data.accent} project-${project.data.slug}${index === 0 ? " is-active" : ""}`}
        data-session-background
      ></div>
    ))}
  </div>
  <div class="sessions-shade" aria-hidden="true"></div>

  <div class="sessions-composition">
  <nav class="sessions-index" aria-label={copy.title}>
    <ol>
      {projects.map((project, index) => (
        <li data-session-index-item class={index === 0 ? "is-active" : ""}>
          <button type="button" data-session-select={index}>
            <strong>
              {(frameworkLinesBySlug[project.data.slug] ?? [project.data.framework]).map((line) => (
                <span>{line}</span>
              ))}
            </strong>
          </button>
        </li>
      ))}
    </ol>
  </nav>

  <div class="sessions-project-stage">
    <div class="sessions-visuals" aria-live="polite">
      {projects.map((project, index) => (
        <figure
          class={`session-visual accent-${project.data.accent}${index === 0 ? " is-active" : ""}`}
          data-session-visual
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <div class="session-visual-frame">
            {project.data.sessionVideo ? (
              <video
                data-heavy-src={project.data.sessionVideo}
                data-poster={project.data.sessionPoster ?? project.data.sessionVisual}
                aria-label={project.data.diagramAlt}
                muted
                loop
                playsinline
                preload="none"
              ></video>
            ) : project.data.slug === "floor-plan-reconstruction" ? (
              <FloorPlanProcess alt={project.data.diagramAlt} />
            ) : (
              <img src={project.data.sessionVisual} alt={project.data.diagramAlt} />
            )}
          </div>
        </figure>
      ))}
    </div>

    <div class="sessions-copy-stack">
      <div class="sessions-details">
        {projects.map((project, index) => (
          <article
            class={`session-detail${index === 0 ? " is-active" : ""}`}
            data-session-detail
            data-slug={project.data.slug}
            aria-hidden={index === 0 ? "false" : "true"}
            inert={index === 0 ? undefined : true}
          >
            <h1 aria-label={sessionTitleLabel(project)}>
              {(titleLinesBySlug[project.data.slug] ?? [project.data.sessionTitle]).map((line) => (
                <span>{line}</span>
              ))}
            </h1>
            <p class="session-summary">{project.data.sessionDescription}</p>
            <button type="button" class="session-watch" data-session-watch>
              <span>{copy.watch}</span>
            </button>
          </article>
        ))}
      </div>

      <div class="sessions-navigation">
        <button type="button" data-session-previous aria-label={copy.previous}>
          <ViewerIcon name="up" size={24} />
        </button>
        <button type="button" data-session-next aria-label={copy.next}>
          <ViewerIcon name="down" size={24} />
        </button>
      </div>
    </div>
  </div>
  </div>
</div>

<script is:inline define:vars={{
  projectSlugs: projects.map((project) => project.data.slug),
  lowTrafficMode,
}}>
  const sessionsView = document.querySelector("[data-sessions-view]");

  if (sessionsView instanceof HTMLElement) {
    const indexItems = [...sessionsView.querySelectorAll("[data-session-index-item]")];
    const visuals = [...sessionsView.querySelectorAll("[data-session-visual]")];
    const details = [...sessionsView.querySelectorAll("[data-session-detail]")];
    const backgrounds = [...sessionsView.querySelectorAll("[data-session-background]")];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
    const conservativeNetwork =
      lowTrafficMode ||
      connection?.saveData === true ||
      /(^|-)2g$/i.test(connection?.effectiveType || "");
    let activeIndex = 0;
    let wheelLocked = false;
    let adjacentPosterIdle = 0;
    let progressiveMediaIdle = 0;
    let preloadGeneration = 0;
    let videoLoadTimer = 0;
    const deckImageDecodePromises = new WeakMap();

    const prepareVideoPoster = (video) => {
      if (!(video instanceof HTMLVideoElement) || video.getAttribute("poster") || !video.dataset.poster) return;
      video.poster = video.dataset.poster;
    };

    const attachVideoSource = (video, preload = "auto") => {
      prepareVideoPoster(video);
      video.preload = preload;
      if (!video.getAttribute("src") && video.dataset.heavySrc) {
        video.src = video.dataset.heavySrc;
        video.load();
      }
    };

    const playVideo = (video) => {
      attachVideoSource(video, "auto");
      video.play().catch(() => {});
    };

    const waitForVideoReady = (video) => {
      if (!(video instanceof HTMLVideoElement) || video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        return Promise.resolve();
      }
      return new Promise((resolve) => {
        let timeout = 0;
        const finish = () => {
          window.clearTimeout(timeout);
          video.removeEventListener("loadeddata", finish);
          video.removeEventListener("error", finish);
          resolve();
        };
        video.addEventListener("loadeddata", finish, { once: true });
        video.addEventListener("error", finish, { once: true });
        timeout = window.setTimeout(finish, 8000);
      });
    };

    const preloadCarouselVideo = async (video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      attachVideoSource(video, "auto");
      await waitForVideoReady(video);
    };

    const firstDeckEpisode = (slug) => {
      const project = document.querySelector(`[data-viewer-project][data-slug="${CSS.escape(slug)}"]`);
      return project?.querySelector("[data-viewer-episode]");
    };

    const loadAndDecodeDeckImage = (image, priority = "low") => {
      if (!(image instanceof HTMLImageElement) || !image.dataset.heavySrc) return Promise.resolve();
      image.fetchPriority = priority;
      image.loading = "eager";
      if (!image.getAttribute("src")) {
        if (image.dataset.heavySizes) image.sizes = image.dataset.heavySizes;
        if (image.dataset.heavySrcset) image.srcset = image.dataset.heavySrcset;
        image.src = image.dataset.heavySrc;
      }
      const existing = deckImageDecodePromises.get(image);
      if (existing) return existing;
      const decoded = image.decode().catch(() => {});
      deckImageDecodePromises.set(image, decoded);
      return decoded;
    };

    const preloadDeckFirstPage = async (slug, priority = "low", includeVideoMetadata = false) => {
      const episode = firstDeckEpisode(slug);
      if (!(episode instanceof HTMLElement)) return;
      const imageDecodes = [...episode.querySelectorAll("img[data-heavy-src]")]
        .map((image) => loadAndDecodeDeckImage(image, priority));
      episode.querySelectorAll("video[data-poster]").forEach(prepareVideoPoster);
      if (includeVideoMetadata) {
        episode.querySelectorAll("video[data-heavy-src]").forEach((video) => {
          if (!(video instanceof HTMLVideoElement)) return;
          attachVideoSource(video, priority === "high" ? "auto" : "metadata");
        });
      }
      await Promise.all(imageDecodes);
    };

    const cancelProgressivePreload = () => {
      preloadGeneration += 1;
      if (!progressiveMediaIdle) return;
      if ("cancelIdleCallback" in window) window.cancelIdleCallback(progressiveMediaIdle);
      else window.clearTimeout(progressiveMediaIdle);
      progressiveMediaIdle = 0;
    };

    const scheduleProgressivePreload = (activeVideo, activeSlug) => {
      cancelProgressivePreload();
      if (conservativeNetwork) return;
      const generation = preloadGeneration;
      const begin = () => {
        if (generation !== preloadGeneration) return;
        void preloadDeckFirstPage(activeSlug, "low", true);
        const preload = async () => {
          if (generation !== preloadGeneration) return;
          const previous = (activeIndex - 1 + visuals.length) % visuals.length;
          const next = (activeIndex + 1) % visuals.length;
          const adjacentVideos = [visuals[previous], visuals[next]]
            .map((visual) => visual?.querySelector("video"))
            .filter((video) => video instanceof HTMLVideoElement);
          await Promise.all(adjacentVideos.map(preloadCarouselVideo));
          if (generation !== preloadGeneration) return;
          const adjacentSet = new Set(adjacentVideos);
          const remainingVideos = visuals
            .map((visual) => visual.querySelector("video"))
            .filter((video) =>
              video instanceof HTMLVideoElement &&
              video !== activeVideo &&
              !adjacentSet.has(video),
            );
          for (const video of remainingVideos) {
            if (generation !== preloadGeneration) return;
            await preloadCarouselVideo(video);
          }
        };
        progressiveMediaIdle = "requestIdleCallback" in window
          ? window.requestIdleCallback(() => void preload(), { timeout: 1800 })
          : window.setTimeout(() => void preload(), 650);
      };
      if (!(activeVideo instanceof HTMLVideoElement) || reducedMotion) begin();
      else if (activeVideo.readyState >= HTMLMediaElement.HAVE_FUTURE_DATA) begin();
      else activeVideo.addEventListener("canplay", begin, { once: true });
    };

    const syncVideos = () => {
      window.clearTimeout(videoLoadTimer);
      const viewIsActive = document.documentElement.dataset.portfolioView === "sessions";
      let activeVideo;
      sessionsView.querySelectorAll("video").forEach((video) => {
        const owner = video.closest("[data-session-visual]");
        const ownerIndex = visuals.indexOf(owner);
        if (viewIsActive && ownerIndex === activeIndex && !reducedMotion) {
          activeVideo = video;
          return;
        }
        video.pause();
      });
      if (activeVideo) {
        videoLoadTimer = window.setTimeout(() => {
          const owner = activeVideo.closest("[data-session-visual]");
          if (
            document.documentElement.dataset.portfolioView === "sessions" &&
            visuals.indexOf(owner) === activeIndex
          ) playVideo(activeVideo);
        }, 120);
      }
    };

    const circularDistance = (index, center) => {
      const count = projectSlugs.length;
      let distance = (index - center) % count;
      if (distance > count / 2) distance -= count;
      if (distance < -count / 2) distance += count;
      return distance;
    };

    const showProject = (nextIndex, announce = true) => {
      activeIndex = (nextIndex + projectSlugs.length) % projectSlugs.length;
      const activeSlug = projectSlugs[activeIndex];
      try {
        window.localStorage.setItem("portfolio:lastProjectSlug", activeSlug);
      } catch {
        // Ignore storage failures; the carousel should keep working without persistence.
      }
      const collections = [indexItems, visuals, details, backgrounds];

      collections.forEach((nodes) => {
        nodes.forEach((node, index) => {
          const distance = circularDistance(index, activeIndex);
          const active = index === activeIndex;
          node.classList.toggle("is-active", active);
          node.classList.toggle("is-previous", distance === -1);
          node.classList.toggle("is-next", distance === 1);
          node.classList.toggle("is-far", Math.abs(distance) > 1);
          node.style.setProperty("--session-distance", String(distance));
          node.style.setProperty("--session-depth", String(Math.abs(distance)));
          node.style.zIndex = String(projectSlugs.length - Math.abs(distance));
          if (node.matches("[data-session-detail], [data-session-visual]")) {
            node.setAttribute("aria-hidden", active ? "false" : "true");
          }
          if (node.matches("[data-session-detail]")) node.inert = !active;
        });
      });

      syncVideos();

      if (adjacentPosterIdle) {
        if ("cancelIdleCallback" in window) window.cancelIdleCallback(adjacentPosterIdle);
        else window.clearTimeout(adjacentPosterIdle);
      }
      const prepareAdjacentPosters = () => {
        const previous = (activeIndex - 1 + visuals.length) % visuals.length;
        const next = (activeIndex + 1) % visuals.length;
        [visuals[previous], visuals[next]].forEach((visual) => {
          visual?.querySelectorAll("video[data-poster]").forEach(prepareVideoPoster);
        });
      };
      adjacentPosterIdle = "requestIdleCallback" in window
        ? window.requestIdleCallback(prepareAdjacentPosters, { timeout: 1200 })
        : window.setTimeout(prepareAdjacentPosters, 450);

      const activeVideo = visuals[activeIndex]?.querySelector("video");
      scheduleProgressivePreload(activeVideo, activeSlug);

      if (window.matchMedia("(max-width: 760px)").matches) {
        indexItems[activeIndex]?.scrollIntoView({
          behavior: reducedMotion ? "auto" : "smooth",
          block: "nearest",
          inline: "center",
        });
      }

      if (announce) {
        window.dispatchEvent(
          new CustomEvent("portfolio:project-change", {
            detail: { slug: activeSlug, source: "sessions" },
          }),
        );
      }
    };

    sessionsView.querySelectorAll("[data-session-select]").forEach((button) => {
      button.addEventListener("click", () => {
        showProject(Number(button.getAttribute("data-session-select")));
      });
    });
    sessionsView.querySelectorAll("[data-session-previous]").forEach((button) => {
      button.addEventListener("click", () => showProject(activeIndex - 1));
    });
    sessionsView.querySelectorAll("[data-session-next]").forEach((button) => {
      button.addEventListener("click", () => showProject(activeIndex + 1));
    });
    sessionsView.querySelectorAll("[data-session-watch]").forEach((button) => {
      const warmDeck = (priority = "low") => {
        if (conservativeNetwork) return Promise.resolve();
        return preloadDeckFirstPage(projectSlugs[activeIndex], priority, true);
      };
      button.addEventListener("pointerenter", () => {
        void warmDeck("low");
      });
      button.addEventListener("focus", () => {
        void warmDeck("low");
      });
      button.addEventListener("click", () => {
        void warmDeck("high");
        window.dispatchEvent(
          new CustomEvent("portfolio:open-deck", {
            detail: { slug: projectSlugs[activeIndex] },
          }),
        );
      });
    });
    sessionsView.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaY) < 18 || wheelLocked) return;
        event.preventDefault();
        wheelLocked = true;
        showProject(activeIndex + (event.deltaY > 0 ? 1 : -1));
        window.setTimeout(() => {
          wheelLocked = false;
        }, reducedMotion ? 120 : 650);
      },
      { passive: false },
    );

    sessionsView.addEventListener("keydown", (event) => {
      if (event.key === "ArrowUp") {
        event.preventDefault();
        showProject(activeIndex - 1);
      }
      if (event.key === "ArrowDown") {
        event.preventDefault();
        showProject(activeIndex + 1);
      }
    });

    window.addEventListener("portfolio:navigate", (event) => {
      const index = projectSlugs.indexOf(event.detail?.slug);
      if (index >= 0) showProject(index, false);
    });
    window.addEventListener("portfolio:project-change", (event) => {
      if (event.detail?.source === "sessions") return;
      const index = projectSlugs.indexOf(event.detail?.slug);
      if (index >= 0) showProject(index, false);
    });
    window.addEventListener("portfolio:view-change", syncVideos);

    const storedProjectSlug = () => {
      try {
        const slug = window.localStorage.getItem("portfolio:lastProjectSlug");
        return projectSlugs.includes(slug) ? slug : "";
      } catch {
        return "";
      }
    };

    const initialSlug = decodeURIComponent(window.location.hash.slice(1)) || storedProjectSlug();
    const initialIndex = projectSlugs.indexOf(initialSlug);
    showProject(initialIndex >= 0 ? initialIndex : 0, false);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        sessionsView.classList.remove("is-hydrating");
      });
    });
  }
</script>

<script>
  import { NeatGradient } from "@firecms/neat";

  const gradientCanvas = document.querySelector("[data-sessions-neat-gradient]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const neatPalettes: Record<string, string[]> = {
    "vision-agent": ["#D95656", "#180707", "#210F12", "#100604", "#F9C571"],
    "robotic-video-intelligence": ["#F9C571", "#04120D", "#0A1C12", "#112506", "#ABEE6A"],
    "multimodal-asset-search": ["#ABEE6A", "#001129", "#06142B", "#003381", "#2C95FF"],
    "lookx-generative-ai": ["#2C95FF", "#14080A", "#1D1024", "#2C1152", "#B56DFF"],
    "floor-plan-reconstruction": ["#B56DFF", "#14080A", "#21100A", "#381007", "#D95656"],
  };

  const toNeatColors = (colors: string[]) => colors.map((color: string) => ({ color, enabled: true }));

  if (gradientCanvas instanceof HTMLCanvasElement && !reducedMotion) {
    try {
      const gradient = new NeatGradient({
        ref: gradientCanvas,
        colors: toNeatColors(
          neatPalettes[decodeURIComponent(window.location.hash.slice(1))] ??
            neatPalettes["robotic-video-intelligence"],
        ),
        speed: 0.85,
        horizontalPressure: 4,
        verticalPressure: 4,
        waveFrequencyX: 3,
        waveFrequencyY: 2,
        waveAmplitude: 1,
        shadows: 2,
        highlights: 2,
        colorBrightness: 0.82,
        colorSaturation: -0.55,
        wireframe: false,
        colorBlending: 7,
        backgroundColor: "#010101",
        backgroundAlpha: 1,
        grainScale: 2,
        grainSparsity: 0,
        grainIntensity: 0,
        grainSpeed: 1,
        resolution: 0.42,
        yOffset: 38,
        yOffsetWaveMultiplier: 2.2,
        yOffsetColorMultiplier: 2.5,
        yOffsetFlowMultiplier: 2.8,
        flowDistortionA: 0.4,
        flowDistortionB: 3,
        flowScale: 3.3,
        flowEase: 0.53,
        flowEnabled: false,
        enableProceduralTexture: false,
        transparentTextureVoid: false,
        textureVoidLikelihood: 0.06,
        textureVoidWidthMin: 10,
        textureVoidWidthMax: 500,
        textureBandDensity: 0.8,
        textureColorBlending: 0.06,
        textureSeed: 333,
        textureEase: 0.68,
        proceduralBackgroundColor: "#003FFF",
        textureShapeTriangles: 20,
        textureShapeCircles: 15,
        textureShapeBars: 15,
        textureShapeSquiggles: 10,
        domainWarpEnabled: false,
        domainWarpIntensity: 0,
        domainWarpScale: 3,
        vignetteIntensity: 0,
        vignetteRadius: 0.8,
        fresnelEnabled: false,
        fresnelPower: 2,
        fresnelIntensity: 0.5,
        fresnelColor: "#FFFFFF",
        iridescenceEnabled: false,
        iridescenceIntensity: 0.5,
        iridescenceSpeed: 1,
        bloomIntensity: 0,
        bloomThreshold: 0.7,
        chromaticAberration: 0,
        shapeType: "plane",
        shapeRotationX: 0,
        shapeRotationY: 0,
        shapeRotationZ: 0,
        shapeAutoRotateSpeedX: 0,
        shapeAutoRotateSpeedY: 0,
        sphereRadius: 15,
        torusRadius: 15,
        torusTube: 5,
        cylinderRadius: 10,
        cylinderHeight: 40,
        planeBend: 0,
        planeTwist: 0,
        silhouetteFade: 0.25,
        cylinderFade: 0.08,
        ribbonFade: 0.05,
        flatShading: true,
        cameraLock: true,
        cameraX: 0,
        cameraY: 0,
        cameraZ: 0,
        cameraRotationX: 0,
        cameraRotationY: 0,
        cameraRotationZ: 0,
        cameraZoom: 1,
      });

      window.addEventListener("portfolio:project-change", (event: Event) => {
        if (!(event instanceof CustomEvent)) return;
        const slug = event.detail?.slug;
        if (typeof slug === "string" && slug in neatPalettes) {
          gradient.colors = toNeatColors(neatPalettes[slug]);
        }
      });
      window.addEventListener("pagehide", () => gradient.destroy(), { once: true });
    } catch {
      gradientCanvas.hidden = true;
    }
  }
</script>

<style>
  .sessions-view {
    --session-ink: #f3f0e8;
    --session-index-face: var(--sans);
    --session-title-face: var(--serif);
    --session-index-w: 27.174%;
    --session-media-w: 46.45%;
    --session-step: 15.22cqw;
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: start center;
    min-height: 100svh;
    padding: 0;
    overflow: hidden;
    color: var(--session-ink);
    background: #101514;
    outline: none;
  }

  .sessions-composition {
    position: relative;
    z-index: 2;
    align-self: center;
    display: grid;
    grid-template-columns: var(--session-index-w) minmax(0, 1fr);
    column-gap: 2.609%;
    /* Scale the complete canonical composition as one unit. Width is primary;
       short viewports constrain the same unit without compressing its parts. */
    width: min(92vw, calc((100svh - 7rem) * 2.4087));
    aspect-ratio: 1324.8 / 550;
    margin-top: 2rem;
    container-type: inline-size;
  }

  .sessions-view.is-hydrating *,
  .sessions-view.is-hydrating *::before,
  .sessions-view.is-hydrating *::after {
    transition: none !important;
    animation-duration: 0.001ms !important;
    animation-delay: 0s !important;
  }

  .sessions-backgrounds,
  .sessions-background,
  .sessions-shade {
    position: absolute;
    inset: 0;
  }

  .sessions-backgrounds {
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .sessions-neat-gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    opacity: 0.34;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .sessions-background {
    --session-accent: #d58b6c;
    --session-base-1: #101514;
    --session-base-2: #070909;
    --session-corner-tr: rgba(255, 124, 82, 0.44);
    --session-corner-bl: rgba(255, 226, 148, 0.18);
    --session-glow-mid: rgba(255, 255, 255, 0.06);
    opacity: 0;
    overflow: hidden;
    z-index: 1;
    background:
      radial-gradient(circle at 82% 18%, var(--session-corner-tr), transparent 40%),
