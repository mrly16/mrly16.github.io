---
import floorIfcViewerScript from "../scripts/floor-ifc-viewer.ts?url";

interface Props {
  locale: "en" | "zh";
}

const { locale } = Astro.props;
const copy =
  locale === "zh"
    ? {
        loading: "正在载入 IFC 模型",
        ready: "拖动旋转 · 滚轮缩放 · 右键平移",
        top: "顶视图",
        axon: "轴测图",
        reset: "重置",
        label: "户型图 IFC 交互查看器",
      }
    : {
        loading: "Loading IFC model",
        ready: "Drag to orbit · Scroll to zoom · Right-drag to pan",
        top: "Top",
        axon: "Axonometric",
        reset: "Reset",
        label: "Interactive floor-plan IFC viewer",
      };
---

<div
  class="floor-ifc-viewer"
  data-floor-ifc-viewer
  data-model-url="/case-studies/floor-plan/ifc-viewer/reconstructed-floorplan.glb"
  aria-label={copy.label}
>
  <canvas class="floor-ifc-canvas" tabindex="0"></canvas>

  <div class="floor-ifc-toolbar" aria-label={copy.label}>
    <button type="button" data-ifc-view="top">{copy.top}</button>
    <button type="button" data-ifc-view="axon">{copy.axon}</button>
    <button type="button" data-ifc-view="reset">{copy.reset}</button>
  </div>

  <p class="floor-ifc-status" data-ifc-status data-loading={copy.loading}>
    {copy.loading}
  </p>
  <p class="floor-ifc-help">{copy.ready}</p>
</div>

<script is:inline type="module" src={floorIfcViewerScript}></script>
