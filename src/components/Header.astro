---
import { siteCopy, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const copy = siteCopy[locale];
const localeTarget =
  locale === "en"
    ? currentPath === "/"
      ? "/zh/"
      : `/zh${currentPath}`
    : currentPath.replace(/^\/zh/, "") || "/";
const isCurrent = (href: string) => currentPath === href || `${currentPath}/` === href;
const nameLabel = locale === "zh" ? "慕容良一" : "Liangyi Murong";
const homeLabel = locale === "zh" ? `返回首页，${nameLabel}` : `Home, ${nameLabel}`;
---

<header class="site-header">
  <a class="wordmark" href={copy.home} aria-label={homeLabel}>
    <svg class="wordmark-logo" xmlns="http://www.w3.org/2000/svg" width="1600" height="360" viewBox="0 0 1600 360" role="img" aria-hidden="true" fill="none">
      <rect width="1600" height="360" fill="transparent"/>
      <text x="40" y="286"
            font-family="halyard-display-variable, Impact, 'Arial Black', sans-serif"
            font-size="340"
            font-weight="900"
            letter-spacing="8"
            fill="#f8f4eb">MRLY</text>
    </svg>
  </a>
  <nav aria-label={locale === "zh" ? "主导航" : "Primary navigation"}>
    <a href={copy.projects} aria-current={isCurrent(copy.projects) ? "page" : undefined}>{copy.nav.work}</a>
    <a href={copy.about} aria-current={isCurrent(copy.about) ? "page" : undefined}>{copy.nav.about}</a>
    <a href={copy.contact} aria-current={isCurrent(copy.contact) ? "page" : undefined}>{copy.nav.contact}</a>
    <a
      class="language-switch"
      href={localeTarget}
      data-locale-switch
      data-locale={locale === "en" ? "zh" : "en"}
      lang={locale === "en" ? "zh-CN" : "en"}
    >
      {copy.language}
    </a>
  </nav>
</header>

<script>
  document.querySelectorAll("[data-locale-switch]").forEach((link) => {
    link.addEventListener("click", () => {
      const locale = link.getAttribute("data-locale");
      if (locale) localStorage.setItem("preferred-locale", locale);
      if (link instanceof HTMLAnchorElement && window.location.pathname.match(/^\/(?:zh\/)?$/)) {
        const target = new URL(link.href);
        target.search = window.location.search;
        target.hash = window.location.hash;
        link.href = target.toString();
      }
    });
  });
</script>
