---
interface Props {
  name:
    | "previous"
    | "next"
    | "pause"
	    | "up"
	    | "down"
	    | "arrow-left"
	    | "undo"
	    | "open"
    | "grid"
    | "info"
    | "monitor"
    | "loop"
    | "mute"
    | "fullscreen"
    | "list"
    | "share"
    | "close";
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  class="viewer-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  {name === "previous" && (
    <>
      <path d="M6.5 6v12" />
      <path d="m17.5 6-7 6 7 6V6Z" />
    </>
  )}
  {name === "next" && (
    <>
      <path d="M17.5 6v12" />
      <path d="m6.5 6 7 6-7 6V6Z" />
    </>
  )}
  {name === "pause" && (
    <>
      <path d="M9 7v10" />
      <path d="M15 7v10" />
    </>
  )}
	  {name === "up" && <path d="m7 14 5-5 5 5" />}
	  {name === "down" && <path d="m7 10 5 5 5-5" />}
	  {name === "arrow-left" && (
	    <>
	      <path d="m12 19-7-7 7-7" />
	      <path d="M19 12H5" />
	    </>
	  )}
	  {name === "undo" && (
	    <>
	      <path d="M9 14 4 9l5-5" />
	      <path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
	    </>
	  )}
  {name === "open" && (
    <>
      <path d="M13 5h6v6" />
      <path d="m19 5-8 8" />
      <path d="M17 13v5H6V7h5" />
    </>
  )}
  {name === "grid" && (
    <>
      <rect x="5" y="5" width="5" height="5" rx="0.5" />
      <rect x="14" y="5" width="5" height="5" rx="0.5" />
      <rect x="5" y="14" width="5" height="5" rx="0.5" />
      <rect x="14" y="14" width="5" height="5" rx="0.5" />
    </>
  )}
  {name === "info" && (
    <>
      <circle cx="12" cy="12" r="7" />
      <path d="M12 11v5" />
      <path d="M12 8.2h.01" />
    </>
  )}
  {name === "monitor" && (
    <>
      <rect x="3.5" y="4.5" width="17" height="12" rx="1.5" />
      <path d="M9 20h6" />
      <path d="M12 16.5V20" />
    </>
  )}
  {name === "loop" && (
    <>
      <path d="M7 7h8a4 4 0 0 1 4 4v1" />
      <path d="m16 9 3 3 3-3" />
      <path d="M17 17H9a4 4 0 0 1-4-4v-1" />
      <path d="m8 15-3-3-3 3" />
    </>
  )}
  {name === "mute" && (
    <>
      <path d="M5 10h3l4-3v10l-4-3H5v-4Z" />
      <path d="m16 9 5 6" />
      <path d="m21 9-5 6" />
    </>
  )}
  {name === "fullscreen" && (
    <>
      <path d="M4 9V4h5" />
      <path d="M15 4h5v5" />
      <path d="M20 15v5h-5" />
      <path d="M9 20H4v-5" />
    </>
  )}
  {name === "list" && (
    <>
      <rect x="4" y="5" width="16" height="14" rx="2" />
      <path d="M8 9h8" />
      <path d="M8 12h8" />
      <path d="M8 15h8" />
    </>
  )}
  {name === "share" && (
    <>
      <circle cx="6" cy="12" r="2" />
      <circle cx="18" cy="6" r="2" />
      <circle cx="18" cy="18" r="2" />
      <path d="m8 11 8-4" />
      <path d="m8 13 8 4" />
    </>
  )}
  {name === "close" && (
    <>
      <path d="m7 7 10 10" />
      <path d="M17 7 7 17" />
    </>
  )}
</svg>

<style>
  .viewer-icon {
    display: block;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
</style>
