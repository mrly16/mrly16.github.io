                            ? "简化轮廓、稳定顶点、正交化边界。"
                            : "Simplify contours, stabilize vertices, and orthogonalize boundaries."}
                        </p>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Wall centerline optimization"
                    data-episode-summary={floorPlanDeck.wallCenterOptimization.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-wallcenter-optimization story-deck story-deck-floor-plan-reconstruction">
