                          </figure>
                          <figure class="floor-room-op-card">
                            <img src="/case-studies/floor-plan/wallcenter-op-2.png" alt="" decoding="async" />
                            <figcaption>{locale === "zh" ? "从图结构到虚拟空间" : "From Graph to Virtual Space"}</figcaption>
                          </figure>
                          <figure class="floor-room-op-card floor-room-op-card-final floor-wallcenter-op-card-final">
                            <span class="floor-room-op-final-media">
                              <img src="/case-studies/floor-plan/wallcenter-op-3.png" alt="" decoding="async" />
                              <img
                                class="floor-room-op-gif floor-wallcenter-op-gif"
                                src="/case-studies/floor-plan/full-layout-optimization-transparent.gif"
                                alt=""
                                loading="eager"
                              />
                            </span>
                            <figcaption>{locale === "zh" ? "门窗构件完成重建" : "Doors and Windows Reconstructed"}</figcaption>
                          </figure>
                        </div>
                        <p class="lookx-feature-statement floor-optimization-statement">
                          <span class="lookx-feature-lead">
                            {locale === "zh" ? "空间骨架提取" : "Spatial skeleton extraction"}
                          </span>
                          <span aria-hidden="true"> — </span>
                          {locale === "zh"
                            ? "移动、精简并合并图结构，得到墙体中心线。"
                            : "Move, reduce, and merge graph elements into wall centerlines."}
                        </p>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title={locale === "zh" ? "IFC 交互模型" : "Interactive IFC"}
                    data-episode-summary={floorPlanDeck.ifcViewer.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-ifc-viewer story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{floorPlanDeck.ifcViewer.title}</h2>
                      </div>
                      <FloorplanIfcViewer locale={locale} />
                    </div>
                  </section>

                </>
              ) : storyDeck ? (
                <>
                  {storyDeck.map((slide, slideIndex) => (
                    <section
                      class={`viewer-episode${slideIndex === 0 ? " is-active" : ""}`}
                      data-viewer-episode
                      data-episode-title={slide.kicker}
