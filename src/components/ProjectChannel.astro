            media: {
              type: "video",
              src: "/case-studies/video-intelligence/wanxiang-hero.mp4",
              poster: "/case-studies/video-intelligence/operations-loop.svg",
            },
            metrics: [
              { value: "8×30 FPS", label: "RTX 4090 streams" },
              { value: "100→5", label: "integration days" },
              { value: "80→2", label: "customer test days" },
            ],
          },
        ],
        "vision-agent": [
          {
            kicker: "PLACEHOLDER",
            title: "Vision that acts with intent",
