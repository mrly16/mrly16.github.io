            layout: "statement",
            media: {
              type: "image",
              src: "/case-studies/vision-agent/vision-agent-frontpage.png",
              alt: "Vision agent harness system concept",
            },
          },
          {
            kicker: "CHOICE",
            title: "From Isolated Detections to History-Aware Visual Decisions",
            summary: "Detection results, corresponding images, and prior decisions are assembled into the prompt context for VLM decision-making.",
            visual: "vision-common-sense",
            layout: "statement",
            media: {
              type: "image",
              src: "/case-studies/vision-agent/vlm-memory-static.png",
              alt: "Vision agent common-sense reasoning and memory concept",
            },
          },
          {
            kicker: "MEMORY",
            title: "Tiered Storage for Detection Data and Decision History",
            summary: "Detections and events stay in task memory; VLM-confirmed facts and decisions persist for reuse across tasks.",
            visual: "vision-feature-dump",
            layout: "statement",
          },
          {
            kicker: "TRIGGER",
            title: "Dual-Track Triggering for VLM Decision Calls",
            summary: "The main track triggers calls at fixed intervals or on events of interest; the side track handles conversation-initiated calls.",
            visual: "vision-context-engineering",
            layout: "statement",
          },
          {
            kicker: "LIVE SYSTEM",
            title: "",
            summary: "",
            visual: "vision-live-demo",
            layout: "statement",
            media: {
              type: "video",
              src: "/case-studies/vision-agent/vision-agent-demo-v3.mp4",
              poster: "/case-studies/vision-agent/vision-agent-demo-poster.jpg",
              alt: "Vision agent interface reasoning over a live video stream",
              caption: "System Demo",
            },
          },
        ],
      };
const copy =
  locale === "zh"
    ? {
        collection: "项目频道",
        scene: "章节",
        previousScene: "上一章节",
        nextScene: "下一章节",
        previousProject: "上一个项目",
        nextProject: "下一个项目",
        backToProjects: "返回项目展映",
        close: "关闭",
        role: "我的角色",
        controls: "项目放映控制台",
        stageAlt: "项目视觉叙事",
        channel: "频道",
        channelUp: "下一个项目",
        channelDown: "上一个项目",
        info: "项目信息",
        overview: "项目概览",
        system: "系统结构",
        evidence: "结果证据",
        ownership: "角色与技术",
        systemSummary: "从输入、关键处理模块到最终输出的系统路径。",
        evidenceSummary: "经过验证的规模、性能与业务结果。",
        ownershipSummary: "个人职责边界、项目周期与主要技术。",
      }
    : {
        collection: "Project channel",
        scene: "Episode",
        previousScene: "Previous episode",
        nextScene: "Next episode",
        previousProject: "Previous project",
        nextProject: "Next project",
        backToProjects: "Back to projects",
        close: "Close",
        role: "My role",
        controls: "Project viewing console",
        stageAlt: "Project visual narrative",
        channel: "Channel",
        channelUp: "Next project",
        channelDown: "Previous project",
        info: "Project info",
        overview: "Project overview",
        system: "System architecture",
        evidence: "Evidence and results",
        ownership: "Ownership and technology",
        systemSummary: "The system path from input through key processing stages to output.",
        evidenceSummary: "Verified scale, performance, and business outcomes.",
        ownershipSummary: "Personal ownership, project period, and principal technologies.",
      };
---

<section class={`work-viewer accent-${projects[0]?.data.accent ?? "terracotta"} project-${projects[0]?.data.slug ?? ""}`} data-work-viewer>
  <p class="viewer-edition" data-viewer-edition>
    <span data-viewer-edition-date>{firstTimeline?.date}</span>
    <span aria-hidden="true">@</span>
    <a
      href={firstCompany?.href}
      target="_blank"
      rel="noreferrer"
      data-viewer-edition-company
    >
      {firstCompany?.name}
    </a>
  </p>

  <div class="viewer-stage" aria-live="polite">
    {projects.map((project, index) => {
      const floorPlan = project.data.slug === "floor-plan-reconstruction";
      const storyDeck = storyDecks[project.data.slug];
      return (
        <article
          class={`viewer-project accent-${project.data.accent} project-${project.data.slug}${index === 0 ? " is-active" : ""}`}
          data-viewer-project
          data-slug={project.data.slug}
          data-index={index}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index === 0 ? undefined : true}
        >
          <div class="viewer-screen">
            <div class="screen-topline">
              <span>{project.data.eyebrow}</span>
              <span>
                CH {String(index + 1).padStart(2, "0")} ·
                <span data-screen-episode-count> EP 01 / 04</span>
              </span>
            </div>

            <div class="viewer-episodes">
              {floorPlan ? (
                <>
                  <section
                    class="viewer-episode is-active"
                    data-viewer-episode
                    data-episode-title={copy.overview}
                    data-episode-summary={floorPlanDeck.context.summary}
                    aria-hidden="false"
                  >
                    <div class="floor-deck floor-deck-context story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <span>00 / WHY IT MATTERS</span>
                        <h2>{floorPlanDeck.context.title}</h2>
                        <p>{floorPlanDeck.context.summary}</p>
                      </div>
                      <figure class="floor-hero-visual" aria-label={locale === "zh" ? "户型图从栅格图像到重建模型的过程" : "Floor plan process from raster image to reconstructed model"}>
                        <img src="/case-studies/floor-plan/floor-plan-hero-v4.png" alt="" decoding="async" />
                      </figure>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Synthetic data"
                    data-episode-summary={floorPlanDeck.synthetic.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-synthetic-engine story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{floorPlanDeck.synthetic.title}</h2>
                        <p>{floorPlanDeck.synthetic.summary}</p>
                      </div>
                      <div class="floor-synthetic-grid">
                        <figure class="floor-synthetic-card">
                          <img
                            src="/case-studies/floor-plan/fp-synt-left.gif"
                            alt={locale === "zh" ? "既有前端渲染专有矢量户型数据" : "Existing frontend rendering proprietary vectorized floor-plan data"}
                            decoding="async"
                          />
                          <figcaption>
                            <strong>{locale === "zh" ? "矢量数据渲染" : "Vector Data Rendering"}</strong>
                            <span>
                              {locale === "zh"
                                ? "前端渲染器解析专有矢量户型数据，并按照构件布局将其绘制到前端画布。"
                                : "The frontend renderer parses proprietary vector floor-plan data and draws each component onto the canvas."}
                            </span>
                          </figcaption>
                        </figure>
                        <figure class="floor-synthetic-card">
                          <img
                            src="/case-studies/floor-plan/fp-synt-mid.gif"
                            alt={locale === "zh" ? "通过 CSS 改写生成标注掩码" : "CSS editing generates annotation masks"}
                            decoding="async"
                          />
                          <figcaption>
                            <strong>{locale === "zh" ? "CSS 属性编辑" : "CSS Attribute Editing"}</strong>
                            <span>
                              {locale === "zh"
                                ? "通过编辑 CSS 属性为独立构件分配标注颜色，并由 Selenium 自动执行整个流程。"
                                : "Layout components are color-coded through CSS edits; the browser workflow is automated with Selenium."}
                            </span>
                          </figcaption>
                        </figure>
                        <figure class="floor-synthetic-card">
                          <img
                            src="/case-studies/floor-plan/fp-synt-right.gif"
                            alt={locale === "zh" ? "区域几何计算生成训练数据" : "Region geometry calculation generates training data"}
                            decoding="async"
                          />
                          <figcaption>
                            <strong>{locale === "zh" ? "多边形几何计算" : "Polygon Geometry Computation"}</strong>
                            <span>
                              {locale === "zh"
                                ? "通过并集、差集等多边形运算组合构件标注，生成最终的分割标签图。"
                                : "The final segmentation masks are generated using polygon operations such as union and difference."}
                            </span>
                          </figcaption>
                        </figure>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Segmentation model"
                    data-episode-summary={floorPlanDeck.graph.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-segmentation story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{floorPlanDeck.graph.title}</h2>
                      </div>
                      <div class="floor-segment-layout" aria-hidden="true">
                        <figure class="floor-segment-panel floor-segment-panel-left">
                          <img src="/case-studies/floor-plan/segment-left.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "矢量户型与像素标注成对生成" : "Paired layout and pixel-level label"}</figcaption>
                        </figure>
                        <figure class="floor-segment-panel floor-segment-panel-right">
                          <img src="/case-studies/floor-plan/segment-right.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "基于 DeepLabV3 训练（mIoU 0.85）" : "Trained with DeepLabV3 (mIoU 0.85)"}</figcaption>
                        </figure>
                        <img
                          class="floor-segment-bottom"
                          src="/case-studies/floor-plan/segment-bottom.png"
                          alt=""
                          decoding="async"
                        />
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Room polygon optimization"
                    data-episode-summary={floorPlanDeck.roomOptimization.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-room-optimization story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{locale === "zh" ? "一阶段优化：空间多边形简化" : "Optimization Stage 1: Room Polygon Regularization"}</h2>
                      </div>
                      <div class="floor-optimization-visual">
                        <div class="floor-room-constraint-layout">
                          <figure class="floor-room-constraint-source">
                            <img
                              src="/case-studies/floor-plan/fp-op1-left.png"
                              alt={locale === "zh" ? "锯齿状房间轮廓优化为稳定房间多边形" : "Zigzagged room contours optimized into stable room polygons"}
                              decoding="async"
                            />
                            <figcaption>
                              {locale === "zh"
                                ? "锯齿状轮廓经过优化，形成边界简化、相邻边方向受约束的空间多边形。"
                                : "Zigzagged raw contours are simplified into simple polygons with constrained edge directions."}
                            </figcaption>
                          </figure>
                          <div class="floor-room-constraint-list" aria-label={locale === "zh" ? "房间多边形优化约束" : "Room polygon optimization constraints"}>
                            {[
                              {
                                label: "L1",
                                image: "/case-studies/floor-plan/room-L1.webp",
                                en: "Keep optimized vertices close to initial predicted boundary vertices.",
                                zh: "保持优化后的顶点接近初始预测边界顶点。",
                              },
                              {
                                label: "L2",
                                image: "/case-studies/floor-plan/room-L2.webp",
                                en: "Favor diagonal or orthogonal adjacent edges.",
                                zh: "优先保持相邻边为对角或正交方向。",
                              },
                              {
                                label: "L3",
                                image: "/case-studies/floor-plan/room-L3.webp",
                                en: "Keep optimized polygon close to the initial polygon.",
                                zh: "保持优化后的多边形接近初始多边形。",
                              },
                            ].map((constraint) => (
                              <article class="floor-room-constraint-item">
                                <span class="floor-room-constraint-badge">{constraint.label}</span>
                                <div class="floor-room-constraint-copy">
                                  <p>{locale === "zh" ? constraint.zh : constraint.en}</p>
                                  <img src={constraint.image} alt="" decoding="async" />
                                </div>
                              </article>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Wall centerline optimization"
                    data-episode-summary={floorPlanDeck.wallCenterOptimization.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-wallcenter-optimization story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{locale === "zh" ? "二阶段优化：空间骨架提取" : "Optimization Stage 2: Spatial Skeleton Extraction"}</h2>
                      </div>
                      <div class="floor-optimization-visual">
                        <div class="floor-room-constraint-layout floor-wall-constraint-layout">
                          <figure class="floor-room-constraint-source">
                            <img
                              src="/case-studies/floor-plan/fp-op2-left.png"
                              alt={locale === "zh" ? "墙体多边形被提取为墙体中心线结构图" : "Wall polygons reduced to wall centerline structural graph"}
                              decoding="async"
                            />
                            <figcaption>
                              {locale === "zh"
                                ? "图优化将相邻房间边界合并为墙体中心线，形成用于空间划分的墙中线骨架。"
                                : "Graph optimization merges adjacent room boundaries into a shared wall-centerline skeleton."}
                            </figcaption>
                          </figure>
                          <div class="floor-room-constraint-list floor-wall-constraint-list" aria-label={locale === "zh" ? "墙体中心线优化约束" : "Wall centerline optimization constraints"}>
                            {[
                              {
                                label: "L1",
                                image: "/case-studies/floor-plan/fp-graph-1.png",
                                en: "Keep adjacent room boundaries close, converging to wall centerlines.",
                                zh: "保持相邻房间边界接近，并收敛到墙体中心线。",
                              },
                              {
                                label: "L2",
                                image: "/case-studies/floor-plan/fp-graph-2.png",
                                en: "Make graph edges strongly diagonal or orthogonal.",
                                zh: "让图结构边尽量保持对角或正交方向。",
                              },
                              {
                                label: "L3",
                                image: "/case-studies/floor-plan/fp-graph-3.png",
                                en: "Keep optimized graph nodes close to their initial positions.",
                                zh: "保持优化后的图节点接近其初始位置。",
                              },
                            ].map((constraint) => (
                              <article class="floor-room-constraint-item floor-wall-constraint-item">
                                <span class="floor-room-constraint-badge">{constraint.label}</span>
                                <div class="floor-room-constraint-copy floor-wall-constraint-copy">
                                  <p>{locale === "zh" ? constraint.zh : constraint.en}</p>
                                  <img src={constraint.image} alt="" decoding="async" />
                                </div>
                              </article>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title={locale === "zh" ? "IFC 交互模型" : "Interactive IFC"}
                    data-episode-summary={floorPlanDeck.ifcViewer.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-ifc-viewer story-deck story-deck-floor-plan-reconstruction">
                      <figure class="floor-ifc-figure">
                        <FloorplanIfcViewer locale={locale} />
                        <p class="floor-ifc-caption">
                          {locale === "zh" ? "交互式 BIM 重建预览" : "Reconstructed BIM model"}
                        </p>
                      </figure>
                    </div>
                  </section>

                </>
              ) : storyDeck ? (
                <>
                  {storyDeck.map((slide, slideIndex) => (
                    <section
                      class={`viewer-episode${slideIndex === 0 ? " is-active" : ""}`}
                      data-viewer-episode
                      data-episode-title={slide.kicker}
                      data-episode-summary={slide.summary}
                      aria-hidden={slideIndex === 0 ? "false" : "true"}
                      inert={slideIndex === 0 ? undefined : true}
                    >
                      <div
                        class={`floor-deck story-deck story-deck-${project.data.slug} story-visual-${slide.visual} story-layout-${resolveStoryLayout(slide, slideIndex)}`}
                      >
                        {slide.title || slide.summary || slide.points || slide.implementationMetrics ? (
                          <div class="floor-deck-copy">
                            {slide.title ? (
                              <h2>
                                {slide.titleLines
                                  ? slide.titleLines.map((line) => <span class="story-title-line">{line}</span>)
                                  : slide.title}
                              </h2>
                            ) : null}
                            {slide.summary ? <p>{slide.summary}</p> : null}
                            {slide.implementationMetrics ? (
                              <dl class="mm-infra-metrics">
                                {slide.implementationMetrics.map((metric) => (
                                  <div>
                                    <dt>{metric.label}</dt>
                                    <dd>{metric.value}</dd>
                                  </div>
                                ))}
                              </dl>
                            ) : null}
                            {slide.points ? (
                              <ul class="story-points">
                                {slide.points.map((point) => (
                                  <li>{point}</li>
                                ))}
                              </ul>
                            ) : null}
                          </div>
                        ) : null}
                        {slide.visual === "lookx-tech-system" ? (
                          <figure class="lookx-tech-visual" aria-label="LookX model training, workflow development, and prompt routing system">
                            <div class="lookx-tech-panel lookx-tech-base">
                              <h3>
                                {locale === "zh" ? "基础模型训练" : "Base Model Training"}
                              </h3>
                              <img src="/case-studies/lookx/tech/base-model-training-v2.png" alt="" decoding="async" />
                            </div>
                            <div class="lookx-tech-panel lookx-tech-workflow">
                              <h3>
                                {locale === "zh" ? "图像生成" : "Image Generation"}
                              </h3>
                              <img src="/case-studies/lookx/tech/image-generation-v2.png" alt="" decoding="async" />
                            </div>
                            <div class="lookx-tech-panel lookx-tech-routing">
                              <h3>
                                {locale === "zh" ? "提示词路由" : "Prompt Routing"}
                              </h3>
                              <img src="/case-studies/lookx/tech/prompt-routing-v2.png" alt="" decoding="async" />
                            </div>
                          </figure>
                        ) : null}
                        {slide.visual === "mm-metadata" ? (
                          <figure class="mm-metadata-visual" aria-label="Multimodal image metadata with annotations, embeddings, captions, tags, and description">
                            <img
                              class="mm-metadata-image"
                              src="/case-studies/multimodal-search/mmsearch-metadata.png"
                              alt=""
                              decoding="async"
                            />
                            <figcaption>{slide.title}</figcaption>
                          </figure>
                        ) : null}
                        {slide.visual === "mm-operations" ? (
                          <div class="mm-operations-visual" aria-label={locale === "zh" ? "视觉数据平台操作能力" : "Visual dataset platform operations"}>
                            <figure class="mm-operations-card">
                              <div class="mm-operations-media">
                                <img src="/case-studies/multimodal-search/mmsearch-zero-det.gif" alt="" decoding="async" />
                                <figcaption>
                                  <strong>{locale === "zh" ? "零样本检测" : "Zero-Shot Detection"}</strong>
                                  <span>{locale === "zh" ? "快速验证新类别和候选数据。" : "Validate new classes and candidate data quickly."}</span>
                                </figcaption>
                              </div>
                            </figure>
                            <figure class="mm-operations-card">
                              <div class="mm-operations-media">
                                <img src="/case-studies/multimodal-search/mmsearch-generate.gif" alt="" decoding="async" />
                                <figcaption>
                                  <strong>{locale === "zh" ? "模板化生成" : "Templated Generation"}</strong>
                                  <span>{locale === "zh" ? "按任务模板批量生成训练素材。" : "Generate training assets from reusable task templates."}</span>
                                </figcaption>
                              </div>
                            </figure>
                            <figure class="mm-operations-card">
                              <div class="mm-operations-media">
                                <img src="/case-studies/multimodal-search/mmsearch-stitch.gif" alt="" decoding="async" />
                                <figcaption>
                                  <strong>{locale === "zh" ? "合成数据与图像编辑" : "Synthetic Data and Image Editing"}</strong>
                                  <span>{locale === "zh" ? "拼接、编辑并扩展可用图像样本。" : "Stitch, edit, and expand usable image samples."}</span>
                                </figcaption>
                              </div>
                            </figure>
                            <figure class="mm-operations-card">
                              <div class="mm-operations-media">
                                <img src="/case-studies/multimodal-search/mmsearch-tag.gif" alt="" decoding="async" />
                                <figcaption>
                                  <strong>{locale === "zh" ? "标签与标注" : "Tags and Annotation"}</strong>
                                  <span>{locale === "zh" ? "维护可检索、可训练的数据标签。" : "Maintain searchable labels for training pipelines."}</span>
                                </figcaption>
                              </div>
                            </figure>
                          </div>
                        ) : null}
                        {slide.visual === "mm-infra" ? (
                          <figure class="mm-infra-visual" aria-label="Multimodal search infrastructure balancing cost, throughput, and retrieval experience">
                            <img
                              class="mm-infra-image"
                              src="/case-studies/multimodal-search/mmsearch-infra.png"
                              alt=""
                              decoding="async"
                            />
                          </figure>
                        ) : null}
                        {slide.visual === "lookx-render-mode" ? (
                          <figure class="lookx-pipeline-visual" aria-label="Three architectural design stages routed into tailored generation pipelines">
                            <img
                              class="lookx-pipeline-image"
                              src={
                                locale === "zh"
                                  ? "/case-studies/lookx/lookx-rendering-zh-v2.png"
                                  : "/case-studies/lookx/lookx-rendering-en-v2.png"
                              }
                              alt=""
                              decoding="async"
                            />
                          </figure>
                        ) : null}
                        {slide.visual === "lookx-lora-training" ? (
                          <figure class="lookx-lora-visual" aria-label="One-click LoRA training workflow for architectural images">
                            <img
                              class="lookx-lora-image"
                              src="/case-studies/lookx/lookx-lora-training.png"
                              alt=""
                              decoding="async"
                            />
                          </figure>
                        ) : null}
                        {slide.visual === "lookx-generate-same" ? (
                          <figure class="lookx-same-visual" aria-label="Generate Same workflow for recreating shared works">
                            <img
                              class="lookx-same-image"
                              src="/case-studies/lookx/lookx-generate-same.png"
                              alt=""
                              decoding="async"
                            />
                          </figure>
                        ) : null}
                        {slide.visual === "video-problem" ? (
                          <div class="video-problem-visual" aria-label="Comparison between lab and field model inference results">
                            <figure>
                              <img src="/case-studies/video-intelligence/problem-left.png" alt="" decoding="async" />
                              <figcaption>{locale === "zh" ? "实验室结果" : "Lab Result"}</figcaption>
                            </figure>
                            <figure>
                              <img src="/case-studies/video-intelligence/problem-right.png" alt="" decoding="async" />
                              <figcaption>{locale === "zh" ? "现场结果" : "Field Result"}</figcaption>
                            </figure>
                          </div>
