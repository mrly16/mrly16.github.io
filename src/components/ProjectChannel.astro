                            muted
                            loop
                            playsinline
                            preload="metadata"
                          ></video>
                          <figcaption>
                            {locale === "zh" ? "几何计算生成标注" : "Geometry-Derived Annotations"}
                          </figcaption>
                        </figure>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Segmentation model"
