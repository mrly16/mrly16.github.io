          title: "墙体中心线把房间多边形合并为空间骨架",
          summary: "通过尺度估计、墙宽计算和图优化，把房间边界收敛为表达墙段、房间和构件关系的中心线图。",
        },
        result: {
          title: "最终得到的是可复用的空间数据",
          summary: "系统生成 5 万+ 矢量户型数据，覆盖中国主流住宅户型，并在 Xkool 多个产品和业务场景中复用。",
        },
      }
    : {
        context: {
          title: "Floor plans are readable, but not computable",
          summary: "Designers can read spatial intent from drawings, but product systems cannot directly measure, vary, analyze, or reuse that space.",
