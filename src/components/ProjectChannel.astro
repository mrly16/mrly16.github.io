                          </figcaption>
                        </figure>
                        <img
                          class="floor-synthetic-arrow"
                          src="/case-studies/floor-plan/synthetic-arrow.png"
                          alt=""
                          aria-hidden="true"
                          decoding="async"
                        />
                        <figure class="floor-synthetic-middle">
                          <img
                            src="/case-studies/floor-plan/synthetic-middle.png"
                            alt={locale === "zh" ? "户型矢量数据与前端几何结构的对应关系" : "Mapping between vectorized floor-plan data and frontend geometry"}
                            decoding="async"
                          />
                          <figcaption>
                            {locale === "zh" ? "前端属性改写" : "Frontend Attribute Editing"}
                          </figcaption>
                        </figure>
                        <img
                          class="floor-synthetic-arrow"
