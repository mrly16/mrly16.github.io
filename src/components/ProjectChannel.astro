type StoryDeckSlide = {
  kicker: string;
  title: string;
  summary: string;
  visual: string;
  layout?: "statement" | "split" | "board" | "process" | "metrics";
  eyebrow?: string;
  points?: string[];
  callout?: {
    label: string;
    value: string;
  };
  media?: {
    type: "image" | "video";
    src: string;
    poster?: string;
    alt?: string;
    caption?: string;
  };
  chips?: string[];
  metrics?: { value: string; label: string }[];
};
const resolveStoryLayout = (slide: StoryDeckSlide, index: number): NonNullable<StoryDeckSlide["layout"]> => {
  if (slide.layout) return slide.layout;
  if (slide.metrics) return "metrics";
  if (index === 0 && slide.callout) return "statement";
  if (slide.points && !slide.media) return "process";
  if (slide.media) return "split";
  return "board";
};
