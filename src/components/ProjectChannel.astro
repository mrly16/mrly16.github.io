            visual: "vision-context",
            media: {
              type: "image",
              src: "/diagrams/vision-agent-placeholder.svg",
              alt: "Vision agent placeholder",
            },
            chips: ["Observe", "Reason", "Act"],
          },
          {
            kicker: "TASK LOOP",
            title: "From perception to decision loop",
            summary:
              "The eventual story should connect visual input, task state, tool use, and feedback rather than showing a single model inference.",
            visual: "vision-loop",
            chips: ["Perception", "State", "Tool use"],
          },
          {
            kicker: "SYSTEM SHAPE",
            title: "Vision, memory, and execution layers",
            summary:
              "The placeholder reserves space for visual encoding, short-term memory, action planning, and execution validation.",
            visual: "vision-system",
            media: {
              type: "image",
              src: "/diagrams/vision-agent-placeholder.svg",
              alt: "Vision agent system placeholder",
            },
          },
          {
            kicker: "COMING NEXT",
            title: "Replace with the real project later",
            summary:
              "For now it only holds the slot and rhythm. Once project material stabilizes, it can be replaced with real metrics, process visuals, and media.",
            visual: "vision-result",
            metrics: [
              { value: "2026", label: "active project" },
              { value: "TBD", label: "media" },
              { value: "TBD", label: "evidence" },
            ],
          },
        ],
      };
const copy =
  locale === "zh"
    ? {
        collection: "项目频道",
        scene: "章节",
        previousScene: "上一章节",
        nextScene: "下一章节",
        previousProject: "上一个项目",
        nextProject: "下一个项目",
        backToProjects: "返回项目展映",
        close: "关闭",
        role: "我的角色",
        controls: "项目放映控制台",
        stageAlt: "项目视觉叙事",
        channel: "频道",
        channelUp: "下一个项目",
        channelDown: "上一个项目",
        info: "项目信息",
        overview: "项目概览",
        system: "系统结构",
        evidence: "结果证据",
        ownership: "角色与技术",
        systemSummary: "从输入、关键处理模块到最终输出的系统路径。",
        evidenceSummary: "经过验证的规模、性能与业务结果。",
        ownershipSummary: "个人职责边界、项目周期与主要技术。",
      }
    : {
        collection: "Project channel",
        scene: "Episode",
        previousScene: "Previous episode",
        nextScene: "Next episode",
        previousProject: "Previous project",
        nextProject: "Next project",
        backToProjects: "Back to projects",
        close: "Close",
        role: "My role",
        controls: "Project viewing console",
        stageAlt: "Project visual narrative",
        channel: "Channel",
        channelUp: "Next project",
        channelDown: "Previous project",
        info: "Project info",
        overview: "Project overview",
        system: "System architecture",
        evidence: "Evidence and results",
        ownership: "Ownership and technology",
        systemSummary: "The system path from input through key processing stages to output.",
        evidenceSummary: "Verified scale, performance, and business outcomes.",
        ownershipSummary: "Personal ownership, project period, and principal technologies.",
      };
---

<section class="work-viewer" data-work-viewer>
  <button type="button" class="viewer-back" data-viewer-back>
    <span aria-hidden="true">←</span>
    <span>{copy.backToProjects}</span>
  </button>

  <p class="viewer-edition" data-viewer-edition>
    <span data-viewer-edition-date>{firstTimeline?.date}</span>
    <span aria-hidden="true">@</span>
    <a
      href={firstCompany?.href}
      target="_blank"
      rel="noreferrer"
      data-viewer-edition-company
    >
      {firstCompany?.name}
    </a>
  </p>

  <div class="viewer-stage" aria-live="polite">
    {projects.map((project, index) => {
      const floorPlan = project.data.slug === "floor-plan-reconstruction";
      const storyDeck = storyDecks[project.data.slug];
      return (
        <article
          class={`viewer-project accent-${project.data.accent}${index === 0 ? " is-active" : ""}`}
          data-viewer-project
          data-slug={project.data.slug}
          data-index={index}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index === 0 ? undefined : true}
        >
          <div class="viewer-screen">
            <div class="screen-topline">
              <span>{project.data.eyebrow}</span>
              <span>
                CH {String(index + 1).padStart(2, "0")} ·
                <span data-screen-episode-count> EP 01 / 04</span>
              </span>
            </div>

            <div class="viewer-episodes">
              {floorPlan ? (
                <>
                  <section
                    class="viewer-episode is-active"
                    data-viewer-episode
                    data-episode-title={copy.overview}
                    data-episode-summary={floorPlanDeck.context.summary}
                    aria-hidden="false"
                  >
                    <div class="floor-deck floor-deck-context story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <span>00 / WHY IT MATTERS</span>
                        <h2>{floorPlanDeck.context.title}</h2>
                        <p>{floorPlanDeck.context.summary}</p>
                      </div>
                      <div class="floor-deck-market" aria-hidden="true">
                        <div class="market-card market-card-main">
                          <img src="/case-studies/floor-plan/source-to-segmentation.webp" alt="" />
                        </div>
                        <div class="market-card market-card-bim">BIM</div>
                        <div class="market-card market-card-search">SEARCH</div>
                        <div class="market-card market-card-cost">MANUAL<br />REBUILD</div>
                        <div class="market-path"></div>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Synthetic data"
                    data-episode-summary={floorPlanDeck.synthetic.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-synthetic">
                      <div class="floor-deck-copy">
                        <span>SYNTHETIC DATA</span>
                        <h2>{floorPlanDeck.synthetic.title}</h2>
                        <p>{floorPlanDeck.synthetic.summary}</p>
                      </div>
                      <div class="synthetic-grid" aria-hidden="true">
                        {["linework", "labels", "symbols", "noise", "style", "mask"].map((item, itemIndex) => (
                          <div class={`synthetic-tile synthetic-tile-${itemIndex}`}>
                            <i></i>
                            <b>{item}</b>
                          </div>
                        ))}
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Graph optimization"
                    data-episode-summary={floorPlanDeck.graph.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-graph">
                      <div class="floor-deck-copy">
                        <span>GRAPH OPTIMIZATION</span>
                        <h2>{floorPlanDeck.graph.title}</h2>
                        <p>{floorPlanDeck.graph.summary}</p>
                      </div>
                      <div class="graph-board" aria-hidden="true">
                        <img src="/case-studies/floor-plan/process-raster.png" alt="" />
                        <svg viewBox="0 0 520 340" role="presentation">
                          <path d="M72 70 H245 V122 H322 V262 H198 V292 H72 Z" />
                          <path d="M245 70 H440 V285 H322 V122 H245 Z" />
                          <path d="M72 177 H198 V292" />
                          <circle cx="72" cy="70" r="5" />
                          <circle cx="245" cy="70" r="5" />
                          <circle cx="322" cy="122" r="5" />
                          <circle cx="440" cy="285" r="5" />
                          <circle cx="198" cy="292" r="5" />
                          <circle cx="72" cy="292" r="5" />
                        </svg>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Vector BIM result"
                    data-episode-summary={floorPlanDeck.result.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-result">
                      <div class="floor-deck-copy">
                        <span>VECTOR / IFC RESULT</span>
                        <h2>{floorPlanDeck.result.title}</h2>
                        <p>{floorPlanDeck.result.summary}</p>
                      </div>
                      <div class="result-stack" aria-hidden="true">
                        <img src="/case-studies/floor-plan/annotated-plan.jpg" alt="" />
                        <video
                          src="/case-studies/floor-plan/floorplan-hero-gradient-textured.mp4"
                          poster="/case-studies/floor-plan/floorplan-hero-gradient-textured-poster.jpg"
                          autoplay
                          muted
                          loop
                          playsinline
                        ></video>
                      </div>
                    </div>
                  </section>
                </>
              ) : storyDeck ? (
                <>
                  {storyDeck.map((slide, slideIndex) => (
                    <section
                      class={`viewer-episode${slideIndex === 0 ? " is-active" : ""}`}
                      data-viewer-episode
                      data-episode-title={slide.kicker}
                      data-episode-summary={slide.summary}
                      aria-hidden={slideIndex === 0 ? "false" : "true"}
                      inert={slideIndex === 0 ? undefined : true}
                    >
                      <div
                        class={`floor-deck story-deck story-deck-${project.data.slug} story-visual-${slide.visual}`}
                      >
                        <div class="floor-deck-copy">
                          <span>{String(slideIndex + 1).padStart(2, "0")} / {slide.kicker}</span>
                          <h2>{slide.title}</h2>
                          <p>{slide.summary}</p>
                        </div>
                        <div class="story-deck-stage" aria-hidden="true">
                          <div class="story-media-card">
                            {slide.media?.type === "video" ? (
                              <video
                                src={slide.media.src}
                                poster={slide.media.poster}
                                autoplay
                                muted
                                loop
                                playsinline
                                preload="metadata"
                              ></video>
                            ) : slide.media ? (
                              <img src={slide.media.src} alt={slide.media.alt ?? ""} loading="lazy" />
                            ) : (
                              <div class="story-abstract">
                                <i></i>
                                <i></i>
                                <i></i>
                              </div>
                            )}
                          </div>
                          <div class="story-signal-grid">
                            {Array.from({ length: 9 }).map((_, signalIndex) => (
                              <i class={`story-signal-${signalIndex}`}></i>
                            ))}
                          </div>
                          {slide.chips ? (
                            <div class="story-chip-row">
                              {slide.chips.map((chip) => (
                                <span>{chip}</span>
                              ))}
                            </div>
                          ) : null}
                          {slide.metrics ? (
                            <dl class="story-metrics">
                              {slide.metrics.map((metric) => (
                                <div>
                                  <dt>{metric.value}</dt>
                                  <dd>{metric.label}</dd>
                                </div>
                              ))}
                            </dl>
                          ) : null}
                        </div>
                      </div>
                    </section>
                  ))}
                </>
              ) : (
                <>
                  <section
                    class="viewer-episode is-active"
                    data-viewer-episode
                    data-episode-title={copy.overview}
                    data-episode-summary={project.data.summary}
                    aria-hidden="false"
                  >
                    {project.data.sessionVideo ? (
                      <div class="media-scene" aria-label={project.data.diagramAlt}>
                        <video
                          src={project.data.sessionVideo}
                          poster={project.data.sessionPoster ?? project.data.sessionVisual}
                          autoplay
                          muted
                          loop
                          playsinline
                          preload="auto"
                        ></video>
                      </div>
                    ) : (
                      <div class="diagram-scene" role="img" aria-label={project.data.diagramAlt}>
                        <img src={project.data.diagram} alt="" decoding="async" />
                      </div>
                    )}

                    <div class="screen-caption">
                      <div>
                        <p>{copy.scene} 01 · {copy.overview}</p>
                        <h1>{project.data.title}</h1>
                      </div>
                      <p>{project.data.summary}</p>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title={copy.system}
                    data-episode-summary={copy.systemSummary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="episode-architecture">
                      <div>
                        <span>02</span>
                        <h2>{copy.system}</h2>
                        <p>{copy.systemSummary}</p>
                      </div>
                      <img src={project.data.diagram} alt={project.data.diagramAlt} loading="lazy" />
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title={copy.evidence}
                    data-episode-summary={copy.evidenceSummary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="episode-evidence">
                      <header>
                        <span>03</span>
                        <div>
                          <h2>{copy.evidence}</h2>
                          <p>{copy.evidenceSummary}</p>
                        </div>
                      </header>
                      <dl>
                        {project.data.metrics.slice(0, 4).map((metric) => (
                          <div>
                            <dt>{metric.value}</dt>
                            <dd>{metric.label}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title={copy.ownership}
                    data-episode-summary={copy.ownershipSummary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="episode-ownership">
                      <header>
                        <span>04</span>
                        <div>
                          <h2>{copy.ownership}</h2>
                          <p>{copy.ownershipSummary}</p>
                        </div>
                      </header>
                      <div class="ownership-content">
                        <div>
                          <small>{copy.role}</small>
                          <strong>{project.data.role}</strong>
                          <span>{project.data.period}</span>
                        </div>
                        <ul>
                          {project.data.technologies.slice(0, 6).map((technology) => (
                            <li>{technology}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </section>
                </>
              )}
            </div>

            <aside class="viewer-info-panel" data-viewer-info-panel aria-hidden="true">
              <div class="viewer-info-heading">
                <div>
                  <p>{copy.info}</p>
                  <h2>{project.data.title}</h2>
                </div>
                <button type="button" data-viewer-info-close aria-label={copy.close}>
                  <ViewerIcon name="close" size={18} />
                </button>
              </div>
              <dl>
                <div>
                  <dt>{copy.role}</dt>
                  <dd>{project.data.role}</dd>
                </div>
                {project.data.metrics.slice(0, 3).map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </div>
                ))}
              </dl>
            </aside>
          </div>
        </article>
      );
    })}
  </div>

  <FlowControlPill projects={projects} locale={locale} />
</section>

<script is:inline define:vars={{ projects: projects.map((project) => ({
  slug: project.data.slug,
  title: project.data.title,
  pillTitleLines: (pillTitles[project.data.slug]?.[locale] ?? [project.data.sessionHeadline ?? project.data.title, ""]),
  timelineDate: timelineMeta[project.data.slug]?.date ?? project.data.period,
  timelineCompanyName: companyLinks[timelineMeta[project.data.slug]?.company]?.name ?? "",
  timelineCompanyHref: companyLinks[timelineMeta[project.data.slug]?.company]?.href ?? "",
  summary: project.data.summary,
  eyebrow: project.data.eyebrow,
  role: project.data.role,
  diagram: project.data.diagram,
})) }}>
  const viewer = document.querySelector("[data-work-viewer]");

  if (viewer instanceof HTMLElement) {
    viewer.classList.add("is-hydrating");
    const projectData = projects;
    const projectNodes = [...viewer.querySelectorAll("[data-viewer-project]")];
    const title = viewer.querySelector("[data-viewer-title]");
    const edition = viewer.querySelector("[data-viewer-edition]");
    const editionDate = viewer.querySelector("[data-viewer-edition-date]");
    const editionCompany = viewer.querySelector("[data-viewer-edition-company]");
    const thumbnail = viewer.querySelector("[data-viewer-thumbnail]");
    const episodeReadout = viewer.querySelector("[data-episode-readout]");
    const consoleEpisodeSummary = viewer.querySelector("[data-console-episode-summary]");
    const episodeDots = [...viewer.querySelectorAll("[data-episode-select]")];
    let activeIndex = 0;
    let activeEpisode = 0;

    const activeEpisodeNodes = () => [
      ...(projectNodes[activeIndex]?.querySelectorAll("[data-viewer-episode]") ?? []),
    ];

    const showEpisode = (nextEpisode) => {
      const episodes = activeEpisodeNodes();
      if (!episodes.length) return;
      activeEpisode = (nextEpisode + episodes.length) % episodes.length;
      episodes.forEach((episode, index) => {
        const active = index === activeEpisode;
        episode.classList.toggle("is-active", active);
        episode.setAttribute("aria-hidden", active ? "false" : "true");
        episode.inert = !active;
      });
      episodeDots.forEach((dot, index) => {
        const active = index === activeEpisode;
        dot.classList.toggle("is-active", active);
        dot.setAttribute("aria-selected", active ? "true" : "false");
      });
      if (episodeReadout) {
        const label = document.documentElement.lang === "zh-CN" ? "章节" : "Episode";
        episodeReadout.textContent = `${label} ${String(activeEpisode + 1).padStart(2, "0")} / ${String(episodes.length).padStart(2, "0")}`;
      }
      const activeEpisodeNode = episodes[activeEpisode];
      const episodeSummary = activeEpisodeNode?.getAttribute("data-episode-summary") ?? "";
      if (consoleEpisodeSummary) consoleEpisodeSummary.textContent = episodeSummary;
      projectNodes[activeIndex]?.querySelectorAll("[data-screen-episode-count]").forEach((counter) => {
        counter.textContent = ` EP ${String(activeEpisode + 1).padStart(2, "0")} / ${String(episodes.length).padStart(2, "0")}`;
      });
    };

    const showProject = (nextIndex, announce = true) => {
      activeIndex = (nextIndex + projectNodes.length) % projectNodes.length;
      projectNodes.forEach((node, index) => {
        const active = index === activeIndex;
        node.classList.toggle("is-active", active);
        node.setAttribute("aria-hidden", active ? "false" : "true");
        node.inert = !active;
        node.querySelector("[data-viewer-info-panel]")?.classList.remove("is-visible");
        node.querySelector("[data-viewer-info-panel]")?.setAttribute("aria-hidden", "true");
      });

      const project = projectData[activeIndex];
      if (!project) return;
      if (title) {
        title.replaceChildren(
          ...project.pillTitleLines.map((line) => {
            const span = document.createElement("span");
            span.textContent = line;
            return span;
          }),
        );
      }
      if (edition) edition.setAttribute("aria-label", `${project.timelineDate} @ ${project.timelineCompanyName}`);
      if (editionDate) editionDate.textContent = project.timelineDate;
      if (editionCompany instanceof HTMLAnchorElement) {
        editionCompany.textContent = project.timelineCompanyName;
        editionCompany.href = project.timelineCompanyHref;
      }
      if (thumbnail instanceof HTMLImageElement) thumbnail.src = project.diagram;
      if (announce) {
        window.dispatchEvent(
          new CustomEvent("portfolio:project-change", {
            detail: { slug: project.slug, source: "tv" },
          }),
        );
      }
      showEpisode(0);
    };

    viewer.querySelector("[data-episode-previous]")?.addEventListener("click", () => {
      showEpisode(activeEpisode - 1);
    });
    viewer.querySelector("[data-episode-next]")?.addEventListener("click", () => {
      showEpisode(activeEpisode + 1);
    });
    viewer.querySelector("[data-viewer-fullscreen]")?.addEventListener("click", async () => {
      try {
        if (!document.fullscreenElement) await viewer.requestFullscreen?.();
        else await document.exitFullscreen?.();
      } catch {
        // Fullscreen availability depends on browser and embedding context.
      }
    });
    viewer.querySelector("[data-viewer-back]")?.addEventListener("click", () => {
      const project = projectData[activeIndex];
      window.dispatchEvent(
        new CustomEvent("portfolio:back-to-sessions", {
          detail: { slug: project?.slug },
        }),
      );
    });
    episodeDots.forEach((dot) => {
      dot.addEventListener("click", () => {
        showEpisode(Number(dot.getAttribute("data-episode-select")));
      });
    });
    viewer.querySelector("[data-project-previous]")?.addEventListener("click", () => {
      showProject(activeIndex - 1);
    });
    viewer.querySelector("[data-project-next]")?.addEventListener("click", () => {
      showProject(activeIndex + 1);
    });
    viewer.querySelector("[data-viewer-info]")?.addEventListener("click", () => {
      const panel = projectNodes[activeIndex]?.querySelector("[data-viewer-info-panel]");
      if (panel instanceof HTMLElement) {
        const visible = panel.classList.toggle("is-visible");
        panel.setAttribute("aria-hidden", visible ? "false" : "true");
      }
    });
    viewer.querySelectorAll("[data-viewer-info-close]").forEach((button) => {
      button.addEventListener("click", () => {
        const panel = button.closest("[data-viewer-info-panel]");
        panel?.classList.remove("is-visible");
        panel?.setAttribute("aria-hidden", "true");
      });
    });
    window.addEventListener("keydown", (event) => {
      const panel = viewer.closest("[data-view-panel]");
      if (panel instanceof HTMLElement && panel.hidden) return;
      if (event.key === "ArrowLeft") showEpisode(activeEpisode - 1);
      if (event.key === "ArrowRight") showEpisode(activeEpisode + 1);
      if (event.key === "ArrowUp") showProject(activeIndex - 1);
      if (event.key === "ArrowDown") showProject(activeIndex + 1);
    });

    const initialSlug = decodeURIComponent(window.location.hash.slice(1));
    const initialIndex = projectData.findIndex((project) => project.slug === initialSlug);
    if (initialIndex >= 0) showProject(initialIndex, false);
    else showEpisode(0);
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        viewer.classList.remove("is-hydrating");
      });
    });
    window.addEventListener("portfolio:navigate", (event) => {
      const index = projectData.findIndex((project) => project.slug === event.detail?.slug);
      if (index >= 0) showProject(index, false);
    });
    window.addEventListener("portfolio:project-change", (event) => {
      if (event.detail?.source === "tv") return;
      const index = projectData.findIndex((project) => project.slug === event.detail?.slug);
      if (index >= 0) showProject(index, false);
    });
  }
</script>
