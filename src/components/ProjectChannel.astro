        backToProjects: "返回项目展映",
        close: "关闭",
        role: "我的角色",
        controls: "项目放映控制台",
        stageAlt: "项目视觉叙事",
        channel: "频道",
        channelUp: "下一个项目",
        channelDown: "上一个项目",
        info: "项目信息",
        overview: "项目概览",
        system: "系统结构",
        evidence: "结果证据",
        ownership: "角色与技术",
        systemSummary: "从输入、关键处理模块到最终输出的系统路径。",
        evidenceSummary: "经过验证的规模、性能与业务结果。",
        ownershipSummary: "个人职责边界、项目周期与主要技术。",
      }
    : {
        collection: "Project channel",
        scene: "Episode",
        previousScene: "Previous episode",
        nextScene: "Next episode",
        previousProject: "Previous project",
        nextProject: "Next project",
        backToProjects: "Back to projects",
        close: "Close",
        role: "My role",
        controls: "Project viewing console",
        stageAlt: "Project visual narrative",
        channel: "Channel",
        channelUp: "Next project",
        channelDown: "Previous project",
        info: "Project info",
        overview: "Project overview",
        system: "System architecture",
        evidence: "Evidence and results",
        ownership: "Ownership and technology",
        systemSummary: "The system path from input through key processing stages to output.",
        evidenceSummary: "Verified scale, performance, and business outcomes.",
        ownershipSummary: "Personal ownership, project period, and principal technologies.",
      };
---

<section class={`work-viewer accent-${projects[0]?.data.accent ?? "terracotta"} project-${projects[0]?.data.slug ?? ""}`} data-work-viewer>
  <p class="viewer-edition" data-viewer-edition>
    <span data-viewer-edition-date>{firstTimeline?.date}</span>
    <span aria-hidden="true">@</span>
    <a
      href={firstCompany?.href}
      target="_blank"
      rel="noreferrer"
      data-viewer-edition-company
    >
      {firstCompany?.name}
    </a>
  </p>

  <div class="viewer-stage" aria-live="polite">
    {projects.map((project, index) => {
      const floorPlan = project.data.slug === "floor-plan-reconstruction";
      const storyDeck = storyDecks[project.data.slug];
      return (
        <article
          class={`viewer-project accent-${project.data.accent} project-${project.data.slug}${index === 0 ? " is-active" : ""}`}
          data-viewer-project
          data-slug={project.data.slug}
          data-index={index}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index === 0 ? undefined : true}
        >
          <div class="viewer-screen">
            <div class="screen-topline">
              <span>{project.data.eyebrow}</span>
              <span>
                CH {String(index + 1).padStart(2, "0")} ·
                <span data-screen-episode-count> EP 01 / 04</span>
              </span>
            </div>

            <div class="viewer-episodes">
              {floorPlan ? (
                <>
                  <section
                    class="viewer-episode is-active"
                    data-viewer-episode
                    data-episode-title={copy.overview}
                    data-episode-summary={floorPlanDeck.context.summary}
                    aria-hidden="false"
                  >
                    <div class="floor-deck floor-deck-context story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <span>00 / WHY IT MATTERS</span>
                        <h2>{floorPlanDeck.context.title}</h2>
                        <p>{floorPlanDeck.context.summary}</p>
                      </div>
                      <figure class="floor-hero-visual" aria-label={locale === "zh" ? "户型图从栅格图像到重建模型的过程" : "Floor plan process from raster image to reconstructed model"}>
                        <img src="/case-studies/floor-plan/floor-plan-hero.png" alt="" decoding="async" />
                        <figcaption class="floor-hero-caption floor-hero-caption-reconstruction">
                          {locale === "zh" ? "重建模型" : "Reconstruction"}
                        </figcaption>
                        <figcaption class="floor-hero-caption floor-hero-caption-vector">
                          {locale === "zh" ? "矢量化数据" : "Vectorized Data"}
                        </figcaption>
                        <figcaption class="floor-hero-caption floor-hero-caption-segmentation">
                          {locale === "zh" ? "语义分割" : "Segmentation"}
                        </figcaption>
                        <figcaption class="floor-hero-caption floor-hero-caption-raster">
                          {locale === "zh" ? "栅格图像" : "Raster Image"}
                        </figcaption>
                      </figure>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Synthetic data"
                    data-episode-summary={floorPlanDeck.synthetic.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-synthetic-engine story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{floorPlanDeck.synthetic.title}</h2>
                        <p>{floorPlanDeck.synthetic.summary}</p>
                      </div>
                      <div class="floor-synthetic-pipeline">
                        <figure class="floor-synthetic-source">
                          <img
                            src="/case-studies/floor-plan/synthetic-left.png"
                            alt={locale === "zh" ? "Xkool ABC 格式的户型矢量数据" : "Vectorized layout data in Xkool ABC format"}
                            decoding="async"
                          />
                          <figcaption>
                            {locale === "zh"
                              ? "Xkool ABC 格式矢量数据"
                              : "Vectorized data in Xkool ABC format"}
                          </figcaption>
                        </figure>
                        <img
                          class="floor-synthetic-arrow"
                          src="/case-studies/floor-plan/synthetic-arrow.png"
                          alt=""
                          aria-hidden="true"
                          decoding="async"
                        />
                        <figure class="floor-synthetic-demo">
                          <video
                            src="/case-studies/floor-plan/synthetic-demo.mp4"
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="metadata"
                          ></video>
                        </figure>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Segmentation model"
                    data-episode-summary={floorPlanDeck.graph.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-segmentation story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{floorPlanDeck.graph.title}</h2>
                      </div>
                      <div class="floor-segment-layout" aria-hidden="true">
                        <figure class="floor-segment-panel floor-segment-panel-left">
                          <img src="/case-studies/floor-plan/segment-left.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "7 万张像素级精确标注" : "70k pixel-perfect annotations"}</figcaption>
                        </figure>
                        <figure class="floor-segment-panel floor-segment-panel-right">
                          <img src="/case-studies/floor-plan/segment-right.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "基于 DeepLabV3 训练（mIoU 0.85）" : "Trained with DeepLabV3 (mIoU 0.85)"}</figcaption>
                        </figure>
                        <img
                          class="floor-segment-bottom"
                          src="/case-studies/floor-plan/segment-bottom.png"
                          alt=""
                          decoding="async"
                        />
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Room polygon optimization"
                    data-episode-summary={floorPlanDeck.roomOptimization.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-room-optimization story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{floorPlanDeck.roomOptimization.title}</h2>
                      </div>
                      <div class="floor-room-op-layout" aria-hidden="true">
                        <figure class="floor-room-op-card">
                          <img src="/case-studies/floor-plan/room-op-1.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "分割是像素级预测，缺少空间结构信息" : "Segmentation is pixel-level prediction without spatial information."}</figcaption>
                        </figure>
                        <figure class="floor-room-op-card">
                          <img src="/case-studies/floor-plan/room-op-2.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "锯齿轮廓会让房间多边形变得复杂" : "Zigzag contours make room polygons unnecessarily complex."}</figcaption>
                        </figure>
                        <figure class="floor-room-op-card floor-room-op-card-final">
                          <span class="floor-room-op-final-media">
                            <img src="/case-studies/floor-plan/room-op-3.png" alt="" decoding="async" />
                            <img
                              class="floor-room-op-gif"
                              src="/case-studies/floor-plan/room-boundary-optimization.gif"
                              alt=""
                              loading="eager"
                            />
                          </span>
                          <figcaption>{locale === "zh" ? "通过删除与合并顶点，让图结构收敛为稳定房间多边形" : "Remove and merge vertices until the room polygon graph stabilizes."}</figcaption>
                        </figure>
                      </div>
                    </div>
                  </section>

                  <section
                    class="viewer-episode"
                    data-viewer-episode
                    data-episode-title="Wall centerline optimization"
                    data-episode-summary={floorPlanDeck.wallCenterOptimization.summary}
                    aria-hidden="true"
                    inert
                  >
                    <div class="floor-deck floor-deck-wallcenter-optimization story-deck story-deck-floor-plan-reconstruction">
                      <div class="floor-deck-copy">
                        <h2>{floorPlanDeck.wallCenterOptimization.title}</h2>
                      </div>
                      <div class="floor-room-op-layout floor-wallcenter-op-layout" aria-hidden="true">
                        <figure class="floor-room-op-card">
                          <img src="/case-studies/floor-plan/wallcenter-op-1.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "墙体不应停留为不规则填充多边形" : "Walls should become centerlines, not irregular filled polygons."}</figcaption>
                        </figure>
                        <figure class="floor-room-op-card">
                          <img src="/case-studies/floor-plan/wallcenter-op-2.png" alt="" decoding="async" />
                          <figcaption>{locale === "zh" ? "矢量户型以墙段组织房间并挂接构件" : "Vector layouts use wall segments to bound rooms and anchor components."}</figcaption>
                        </figure>
                        <figure class="floor-room-op-card floor-room-op-card-final floor-wallcenter-op-card-final">
                          <span class="floor-room-op-final-media">
                            <img src="/case-studies/floor-plan/wallcenter-op-3.png" alt="" decoding="async" />
                            <img
                              class="floor-room-op-gif floor-wallcenter-op-gif"
                              src="/case-studies/floor-plan/full-layout-optimization-transparent.gif"
                              alt=""
                              loading="eager"
                            />
                          </span>
                          <figcaption>{locale === "zh" ? "结合比例与墙宽计算，图像才能变成完整设计数据" : "Scale and wall-width estimation turn the layout image into design data."}</figcaption>
                        </figure>
                      </div>
                    </div>
                  </section>

                </>
              ) : storyDeck ? (
                <>
                  {storyDeck.map((slide, slideIndex) => (
                    <section
                      class={`viewer-episode${slideIndex === 0 ? " is-active" : ""}`}
                      data-viewer-episode
                      data-episode-title={slide.kicker}
                      data-episode-summary={slide.summary}
                      aria-hidden={slideIndex === 0 ? "false" : "true"}
                      inert={slideIndex === 0 ? undefined : true}
                    >
                      <div
                        class={`floor-deck story-deck story-deck-${project.data.slug} story-visual-${slide.visual} story-layout-${resolveStoryLayout(slide, slideIndex)}`}
                      >
                        <div class="floor-deck-copy">
                          <h2>{slide.title}</h2>
                          <p>{slide.summary}</p>
                          {slide.points ? (
                            <ul class="story-points">
                              {slide.points.map((point) => (
                                <li>{point}</li>
                              ))}
                            </ul>
                          ) : null}
                        </div>
                        {slide.visual === "lookx-tech-system" ? (
                          <figure class="lookx-tech-visual" aria-label="LookX model training, workflow development, and prompt routing system">
                            <div class="lookx-tech-panel lookx-tech-base">
                              <img src="/case-studies/lookx/tech/base-model-training.png" alt="" decoding="async" />
                              <figcaption class="lookx-tech-caption lookx-tech-caption-title lookx-tech-base-title">
                                {locale === "zh" ? "基础模型训练" : "Base Model Training"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-base-dataset">
                                {locale === "zh" ? "私有数据集" : "Proprietary Dataset"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-base-caption-tool">
                                {locale === "zh" ? "内部图文标注工具" : "Internal Caption Tool"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-base-pairs">
                                {locale === "zh" ? "{图像，描述} 对" : "{image, caption} Pairs"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-base-model">
                                {locale === "zh" ? "建筑扩散模型" : "Architectural Diffusion Model"}
                              </figcaption>
                            </div>
                            <div class="lookx-tech-panel lookx-tech-workflow">
                              <img src="/case-studies/lookx/tech/image-generation.png" alt="" decoding="async" />
                              <figcaption class="lookx-tech-caption lookx-tech-caption-title lookx-tech-workflow-title">
                                {locale === "zh" ? "图像生成" : "Image Generation"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-workflow-comfy">
                                {locale === "zh" ? "ComfyUI 工作流" : "Comfyui Workflows"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-workflow-json">
                                {locale === "zh" ? "API 请求的 .json 配置" : ".json for API requests"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-workflow-features">
                                {locale === "zh" ? "产品功能" : "Product Features"}
                              </figcaption>
                            </div>
                            <div class="lookx-tech-panel lookx-tech-routing">
                              <img src="/case-studies/lookx/tech/prompt-routing.png" alt="" decoding="async" />
                              <figcaption class="lookx-tech-caption lookx-tech-caption-title lookx-tech-routing-title">
                                {locale === "zh" ? "提示词路由" : "Prompt Routing"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-routing-prompt">
                                {locale === "zh" ? "用户提示词" : "User Prompt"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-routing-embedding">
                                {locale === "zh" ? "提示词嵌入模型" : "Prompt Embedding Model"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-routing-similar">
                                {locale === "zh" ? "查找最相似描述" : "Find Most Similar"}
                              </figcaption>
                              <figcaption class="lookx-tech-caption lookx-tech-caption-small lookx-tech-routing-pipeline">
                                {locale === "zh" ? "生成管线路由" : "Pipeline Routing"}
                              </figcaption>
                            </div>
                          </figure>
                        ) : null}
                        {slide.visual === "mm-metadata" ? (
                          <figure class="mm-metadata-visual" aria-label="Multimodal image metadata with annotations, embeddings, captions, tags, and description">
                            <img
                              class="mm-metadata-image"
                              src="/case-studies/multimodal-search/mmsearch-metadata.png"
                              alt=""
                              decoding="async"
                            />
                          </figure>
                        ) : null}
                        {slide.visual === "mm-infra" ? (
                          <figure class="mm-infra-visual" aria-label="Multimodal search infrastructure balancing cost, throughput, and retrieval experience">
                            <img
                              class="mm-infra-image"
                              src="/case-studies/multimodal-search/mmsearch-infra.png"
                              alt=""
                              decoding="async"
                            />
                          </figure>
                        ) : null}
                        {slide.visual === "lookx-render-mode" ? (
                          <figure class="lookx-pipeline-visual" aria-label="Three architectural design stages routed into tailored generation pipelines">
                            <img
                              class="lookx-pipeline-image"
                              src="/case-studies/lookx/lookx-rendering-v3.png"
                              alt=""
                              decoding="async"
                            />
                            <figcaption class="lookx-pipeline-caption-row">
                              <p class="lookx-pipeline-caption lookx-pipeline-caption-stages">
                                {locale === "zh" ? (
                                  <>建筑设计流程的<br />三个核心阶段</>
                                ) : (
                                  <>3 core stages of<br />architectural design process</>
                                )}
                              </p>
                              <p class="lookx-pipeline-caption lookx-pipeline-caption-render">
                                {locale === "zh" ? (
                                  <>3 条定制生成管线<br />确保生产级建筑渲染质量</>
                                ) : (
                                  <>3 tailored generation pipelines<br />Ensuring production-quality architectural rendering</>
                                )}
                              </p>
                            </figcaption>
                          </figure>
                        ) : null}
                        {slide.visual === "lookx-lora-training" ? (
                          <figure class="lookx-lora-visual" aria-label="One-click LoRA training workflow for architectural images">
                            <img
                              class="lookx-lora-image"
                              src="/case-studies/lookx/lookx-lora-training.png"
                              alt=""
                              decoding="async"
                            />
                            <figcaption class="lookx-lora-caption-row">
                              <p class="lookx-lora-caption lookx-lora-caption-setup">
                                {locale === "zh" ? (
                                  <>上传图片，命名 LoRA<br />选择底模，即可训练</>
                                ) : (
                                  <>Upload images, name the LoRA<br />choose a base, and train</>
                                )}
                              </p>
                              <p class="lookx-lora-caption lookx-lora-caption-quality">
                                {locale === "zh" ? (
                                  <>可迁移、有表达力、易融合的 LoRA<br />为建筑图像定制</>
                                ) : (
                                  <>Transferable, expressive, easy-fusion LoRAs<br />tailored for architectural images</>
                                )}
                              </p>
                            </figcaption>
                          </figure>
                        ) : null}
                        {slide.visual === "lookx-generate-same" ? (
                          <figure class="lookx-same-visual" aria-label="Generate Same workflow for recreating shared works">
                            <img
                              class="lookx-same-image"
                              src="/case-studies/lookx/lookx-generate-same.png"
                              alt=""
                              decoding="async"
                            />
                            <figcaption class="lookx-same-caption-row">
                              <p class="lookx-same-caption lookx-same-caption-recreate">
                                {locale === "zh" ? (
                                  <>生成同款可以<br />精确复刻一张作品</>
                                ) : (
                                  <>Generate-the-same feature allows<br />user to precisely recreate a work</>
                                )}
                              </p>
                              <p class="lookx-same-caption lookx-same-caption-community">
                                {locale === "zh" ? (
                                  <>创作广场的共享参数包<br />让社区成为可复用工作流来源</>
                                ) : (
                                  <>Shared parameter bundles in Creation Plaza turn the community into a<br />living source of reusable workflows</>
                                )}
                              </p>
                            </figcaption>
                          </figure>
                        ) : null}
                        {slide.visual === "video-problem" ? (
                          <div class="video-problem-visual" aria-label="Comparison between lab and field model inference results">
                            <figure>
                              <img src="/case-studies/video-intelligence/problem-left.png" alt="" decoding="async" />
                              <figcaption>{locale === "zh" ? "室内结果" : "Result at home"}</figcaption>
                            </figure>
                            <figure>
                              <img src="/case-studies/video-intelligence/problem-right.png" alt="" decoding="async" />
                              <figcaption>{locale === "zh" ? "现场结果" : "Result in field"}</figcaption>
                            </figure>
                          </div>
                        ) : null}
                        {slide.visual === "video-system-architecture" ? (
                          <figure class="video-system-architecture-visual" aria-label={locale === "zh" ? "视频分析引擎系统架构图" : "System architecture diagram for the video analysis engine"}>
                            <img src="/case-studies/video-intelligence/system-architecture.png" alt="" decoding="async" />
                          </figure>
                        ) : null}
                        {slide.visual === "video-product-workflow" ? (
                          <div class="video-product-workflow-visual" aria-label={locale === "zh" ? "视频智能平台产品工作流" : "Video intelligence product workflow"}>
                            {[
                              {
                                title: locale === "zh" ? "流式任务" : "Streaming Tasks",
                                tags: ["FDE", locale === "zh" ? "客户" : "Client"],
                                image: "/case-studies/video-intelligence/product-streaming.png",
                                caption:
                                  locale === "zh"
                                    ? "现场数据采集与算法压力测试：无人机飞行、多路流模拟、实时 bbox 反馈"
                                    : "Field data collection and algorithm stress-testing: drone flights, multi-stream simulation, live bbox feedback",
                              },
                              {
                                title: locale === "zh" ? "文件推理" : "File Inference",
                                tags: ["MLE", "Dev", "QA"],
                                image: "/case-studies/video-intelligence/product-file-inference.png",
                                caption:
                                  locale === "zh"
                                    ? "围绕验收标准做离线批量验证：模型 A/B 对比、逐帧真值复核"
                                    : "Batch offline validation against exit criteria: model A/B comparison, per-frame ground truth review",
                              },
                              {
                                title: locale === "zh" ? "复盘分析" : "Review & Analysis",
                                tags: [locale === "zh" ? "销售" : "Sales", "MLE", "QA"],
                                image: "/case-studies/video-intelligence/product-review-analysis.png",
                                caption:
                                  locale === "zh"
                                    ? "为相关方整理可交付证据：时间线回放、事件截图、可分享片段"
                                    : "Curated evidence for stakeholders: timeline replay, event snapshots, shareable clips",
                              },
                            ].map((item) => (
                              <figure class="video-product-card">
                                <header>
                                  <h3>{item.title}</h3>
                                  <div class="video-product-tags">
                                    {item.tags.map((tag) => (
                                      <span>{tag}</span>
                                    ))}
                                  </div>
                                </header>
                                <img src={item.image} alt="" decoding="async" />
                                <figcaption>{item.caption}</figcaption>
                              </figure>
                            ))}
                          </div>
                        ) : null}
                        {slide.visual === "video-uiux-highlights" ? (
                          <div class="video-uiux-grid" aria-label={locale === "zh" ? "视频智能平台交互亮点" : "Video intelligence UI interaction highlights"}>
                            {[
                              {
                                title: locale === "zh" ? "前端解耦渲染" : "Decoupled Rendering",
                                image: "/case-studies/video-intelligence/uiux/decoupled-rendering.gif",
                                caption:
                                  locale === "zh"
                                    ? "检测框与轨迹由前端渲染，而不是烧进视频帧，让结果展示可以随时筛选、换样式和叠加信息。"
                                    : "Inference overlays are rendered in the frontend instead of burned into frames, making visualization flexible and customizable.",
                              },
                              {
                                title: locale === "zh" ? "逐帧进度追踪" : "Frame Progress Tracking",
                                image: "/case-studies/video-intelligence/uiux/progress-bar.gif",
                                caption:
                                  locale === "zh"
