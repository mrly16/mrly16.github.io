                              <img
                                class="floor-room-op-gif"
                                src="/case-studies/floor-plan/room-boundary-optimization.gif"
                                alt=""
                                loading="eager"
                              />
                            </span>
                            <figcaption>{locale === "zh" ? "干净稳定的房间多边形" : "Clean, Stable Room Polygons"}</figcaption>
                          </figure>
                        </div>
                        <p class="lookx-feature-statement floor-optimization-statement">
