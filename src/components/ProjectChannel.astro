---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import FlowControlPill from "./FlowControlPill.astro";
import ViewerIcon from "./ViewerIcon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const companyLinks = {
  avant: {
    name: "Avant Robotics",
    href: "https://www.linkedin.com/company/avant-robotics-global/",
  },
  xkool: {
    name: "Xkool Technology",
    href: "https://www.xkool.ai/",
  },
} as const;
const timelineMeta: Record<string, { date: string; company: keyof typeof companyLinks }> = {
  "vision-agent": { date: "2026.02 - Now", company: "avant" },
  "robotic-video-intelligence": { date: "2025.07 - 2025.12", company: "avant" },
  "multimodal-asset-search": { date: "2025.04 - 2025.07", company: "avant" },
  "lookx-generative-ai": { date: "2023.09 - 2024.09", company: "xkool" },
  "floor-plan-reconstruction": { date: "2022.03 - 2023.01", company: "xkool" },
};
const pillTitles: Record<string, { en: [string, string]; zh: [string, string] }> = {
  "vision-agent": { en: ["Eyes with", "intent"], zh: ["有意图的", "眼睛"] },
  "robotic-video-intelligence": { en: ["Cameras become", "memory"], zh: ["镜头成为", "记忆"] },
  "multimodal-asset-search": { en: ["Search by", "feeling"], zh: ["以感觉", "搜寻"] },
  "lookx-generative-ai": { en: ["Images learn", "to dream"], zh: ["图像开始", "做梦"] },
  "floor-plan-reconstruction": { en: ["Pixels become", "rooms"], zh: ["像素长成", "房间"] },
};
const firstTimeline = projects[0] ? timelineMeta[projects[0].data.slug] : undefined;
const firstCompany = firstTimeline ? companyLinks[firstTimeline.company] : undefined;
const floorPlanDeck =
  locale === "zh"
    ? {
        context: {
          title: "让户型图成为空间数据",
          summary: "把静态图纸转成可编辑、可检索、可计算的空间模型，连接设计自动化、资产管理与数字孪生。",
        },
        synthetic: {
          title: "合成数据训练分割",
          summary: "真实标注稀缺，先用可控合成户型和语义标签训练模型，再用风格扰动覆盖真实图纸差异。",
        },
        graph: {
          title: "图优化重建墙线拓扑",
          summary: "房间多边形提供墙体中心线线索；节点融合、正交约束和边线吸附把噪声轮廓收敛成稳定图结构。",
        },
        result: {
          title: "矢量化导出 BIM / IFC",
          summary: "门窗投影回墙线，房间和墙体变成语义几何，最终可以导出、渲染、测量和交互。",
        },
      }
    : {
        context: {
          title: "Floor plans become spatial data",
          summary: "Turning static plans into editable, searchable, computable space unlocks design automation, asset intelligence, and digital-twin workflows.",
        },
        synthetic: {
          title: "Synthetic data for segmentation",
          summary: "Scarce labels are bootstrapped with controllable generated plans, semantic masks, and style randomization across drawing conventions.",
        },
        graph: {
          title: "Graph optimization for topology",
          summary: "Room polygons imply wall centerlines; node fusion, orthogonal constraints, and edge attraction stabilize the structural graph.",
        },
        result: {
          title: "Vectorization to BIM / IFC",
          summary: "Openings are projected back onto wall lines; rooms and walls become semantic geometry that can be exported, rendered, measured, and interacted with.",
        },
      };
type StoryDeckSlide = {
  kicker: string;
  title: string;
  summary: string;
  visual: string;
  media?: {
    type: "image" | "video";
    src: string;
    poster?: string;
    alt?: string;
  };
  chips?: string[];
  metrics?: { value: string; label: string }[];
};
const storyDecks: Record<string, StoryDeckSlide[]> =
  locale === "zh"
    ? {
        "lookx-generative-ai": [
          {
            kicker: "WHY IT MATTERS",
            title: "建筑生成必须可控",
            summary:
              "建筑师需要的是可迭代的视觉方案，不是复杂的模型参数。生成式 AI 只有被封装进专业工作流，才可能进入真实产品。",
            visual: "lookx-context",
            media: {
              type: "video",
              src: "/case-studies/lookx/lookx-hero.mp4",
              poster: "/case-studies/lookx/lookx-hero-poster.jpg",
            },
            chips: ["Sketch", "Concept", "Render"],
          },
          {
            kicker: "WORKFLOW DESIGN",
            title: "三种任务模式",
            summary:
              "Sketch、Concept、Render 对应不同设计阶段，把 ControlNet、默认参数和模型行为藏在少量有意义的操作后面。",
            visual: "lookx-workflow",
            chips: ["草图探索", "体块概念", "精细渲染"],
          },
          {
            kicker: "MODEL / DATA",
            title: "领域模型与数据工具",
            summary:
              "基于 Stable Diffusion 1.5 和定制 ControlNet，配合约 1 万张建筑训练图、caption 与清洗工具迭代模型。",
            visual: "lookx-model",
            media: {
              type: "image",
              src: "/diagrams/lookx.svg",
              alt: "LookX architecture diagram",
            },
            chips: ["SD 1.5", "ControlNet", "10K data", "ComfyUI"],
          },
          {
            kicker: "PRODUCT RESULT",
            title: "从模型能力到商业产品",
            summary:
              "Render Mode 成为主要使用场景；关键不是模型炫技，而是几何控制、速度和交互封装。",
            visual: "lookx-result",
            media: {
              type: "video",
              src: "/case-studies/lookx/lookx-hero.mp4",
              poster: "/case-studies/lookx/lookx-hero-poster.jpg",
            },
            metrics: [
              { value: "40万+", label: "注册用户" },
              { value: "70%+", label: "来自 Render 模式" },
              { value: "20秒", label: "单次生成" },
            ],
          },
        ],
        "multimodal-asset-search": [
          {
            kicker: "WHY IT MATTERS",
            title: "百万图片不能靠文件夹管理",
            summary:
              "建模、测试、算法和产品团队需要共享发现系统，而不是在本地目录里猜文件名。",
            visual: "mm-context",
            media: {
              type: "video",
              src: "/case-studies/multimodal-search/mmsearch-hero-gradient.mp4",
              poster: "/case-studies/multimodal-search/mmsearch-hero-gradient-poster.jpg",
            },
            chips: ["Text", "Image", "Tag", "Caption"],
          },
          {
            kicker: "EMBEDDING LAYER",
            title: "CLIP 让视觉资产可检索",
            summary:
              "文本、图片、标签和 caption 被映射到同一语义空间，搜索从文件管理变成视觉发现。",
            visual: "mm-embedding",
            chips: ["CLIP", "Vector Search", "Metadata"],
          },
          {
            kicker: "CLOUD SYSTEM",
            title: "GPU 批处理与云检索分层",
            summary:
              "GKE 承接长时间 GPU embedding 批任务，Cloud Run 承接用户搜索，BigQuery 和 Vertex 连接语义与元数据。",
            visual: "mm-architecture",
            media: {
              type: "image",
              src: "/diagrams/multimodal-search.svg",
              alt: "Multimodal search cloud architecture",
            },
          },
          {
            kicker: "RESULT",
            title: "一秒级多模态发现",
            summary:
              "100 万张图片被索引进统一平台，预热后搜索约 1 秒返回，支持多个内部团队复用资产。",
            visual: "mm-result",
            media: {
              type: "video",
              src: "/case-studies/multimodal-search/mmsearch-hero-gradient.mp4",
              poster: "/case-studies/multimodal-search/mmsearch-hero-gradient-poster.jpg",
            },
            metrics: [
              { value: "100万", label: "图片索引" },
              { value: "约1秒", label: "预热后搜索" },
              { value: "100+ FPS", label: "embedding 吞吐" },
            ],
          },
        ],
        "robotic-video-intelligence": [
          {
            kicker: "WHY IT MATTERS",
            title: "POC 缺的是共同系统",
            summary:
              "设备、算法、操作人员和客户证据需要被连接起来；缺的不是另一个检测模型，而是一条可复现的现场链路。",
            visual: "video-context",
            media: {
              type: "image",
              src: "/case-studies/video-intelligence/operations-loop.svg",
              alt: "Video operations loop",
            },
          },
          {
            kicker: "TASK WORKFLOW",
            title: "任务比模型调用更重要",
            summary:
              "流转流、文件转流、文件转文件把实时演示、历史回放和批量回归统一到同一个任务系统。",
            visual: "video-workflow",
            chips: ["Stream → Stream", "File → Stream", "File → File"],
          },
          {
            kicker: "SYSTEM LAYERS",
            title: "媒体、GPU、事件证据层",
            summary:
              "GStreamer 管媒体，GPU 服务管推理，事件层保存快照、时间戳和帧级结果，让失败可以复现。",
            visual: "video-system",
            media: {
              type: "image",
              src: "/diagrams/video-platform.svg",
              alt: "Video intelligence platform architecture",
            },
          },
          {
            kicker: "RESULT",
            title: "让现场演示可复现",
            summary:
              "平台把算法接入、客户测试和现场演示收敛到统一工作区，减少重复部署与分散反馈。",
            visual: "video-result",
            media: {
              type: "video",
              src: "/case-studies/video-intelligence/wanxiang-hero.mp4",
              poster: "/case-studies/video-intelligence/operations-loop.svg",
            },
            metrics: [
              { value: "8×30 FPS", label: "RTX 4090 并发流" },
              { value: "100→5", label: "集成调试人天" },
              { value: "80→2", label: "客户测试人天" },
            ],
          },
        ],
        "vision-agent": [
          {
            kicker: "PLACEHOLDER",
            title: "让视觉理解带着目标行动",
            summary:
              "这是一个进行中的 Vision Agent 项目位。先用占位 deck 保持整体叙事节奏，后续再替换成真实任务、系统和证据。",
            visual: "vision-context",
            media: {
              type: "image",
              src: "/diagrams/vision-agent-placeholder.svg",
              alt: "Vision agent placeholder",
            },
            chips: ["Observe", "Reason", "Act"],
          },
          {
            kicker: "TASK LOOP",
            title: "从看见到决策闭环",
            summary:
              "未来内容会围绕感知输入、任务状态、工具调用和反馈闭环展开，而不是只展示一次模型推理。",
            visual: "vision-loop",
            chips: ["Perception", "State", "Tool use"],
          },
          {
            kicker: "SYSTEM SHAPE",
            title: "视觉、记忆与执行层",
            summary:
              "占位结构预留给视觉编码、短期记忆、动作规划和执行验证，保证项目加入后不破坏现有 deck 体系。",
            visual: "vision-system",
            media: {
              type: "image",
              src: "/diagrams/vision-agent-placeholder.svg",
              alt: "Vision agent system placeholder",
            },
          },
          {
            kicker: "COMING NEXT",
            title: "真实项目完成后替换",
            summary:
              "当前只承担入口和节奏占位；等项目素材稳定后，再补充真实指标、过程图和演示媒体。",
            visual: "vision-result",
            metrics: [
              { value: "2026", label: "active project" },
              { value: "TBD", label: "media" },
              { value: "TBD", label: "evidence" },
            ],
          },
        ],
      }
    : {
        "lookx-generative-ai": [
          {
            kicker: "WHY IT MATTERS",
            title: "Architectural generation must be controllable",
            summary:
              "Architects need iterative visual options, not a wall of model parameters. Generative AI becomes useful only when it is wrapped into a professional workflow.",
            visual: "lookx-context",
            media: {
              type: "video",
              src: "/case-studies/lookx/lookx-hero.mp4",
              poster: "/case-studies/lookx/lookx-hero-poster.jpg",
            },
            chips: ["Sketch", "Concept", "Render"],
          },
          {
            kicker: "WORKFLOW DESIGN",
            title: "Three task-shaped modes",
            summary:
              "Sketch, Concept, and Render map to real design stages, hiding ControlNet setup, defaults, and model behavior behind meaningful actions.",
            visual: "lookx-workflow",
            chips: ["Sketch exploration", "Concept massing", "Detailed render"],
          },
          {
            kicker: "MODEL / DATA",
            title: "Domain model and data tooling",
            summary:
              "Stable Diffusion 1.5 and custom ControlNet were iterated with roughly 10K architectural training images, captions, and cleaning tools.",
            visual: "lookx-model",
            media: {
              type: "image",
              src: "/diagrams/lookx.svg",
              alt: "LookX architecture diagram",
            },
            chips: ["SD 1.5", "ControlNet", "10K data", "ComfyUI"],
          },
          {
            kicker: "PRODUCT RESULT",
            title: "From model capability to product",
            summary:
              "Render Mode became the dominant use case; the point was not model spectacle, but geometry control, latency, and interaction design.",
            visual: "lookx-result",
            media: {
              type: "video",
              src: "/case-studies/lookx/lookx-hero.mp4",
              poster: "/case-studies/lookx/lookx-hero-poster.jpg",
            },
            metrics: [
              { value: "400K+", label: "registered users" },
              { value: "70%+", label: "from Render Mode" },
              { value: "20s", label: "generation time" },
            ],
          },
        ],
        "multimodal-asset-search": [
          {
            kicker: "WHY IT MATTERS",
            title: "A million images cannot live in folders",
            summary:
              "Modeling, testing, algorithm, and product teams needed shared visual discovery instead of guessing filenames in local directories.",
            visual: "mm-context",
            media: {
              type: "video",
              src: "/case-studies/multimodal-search/mmsearch-hero-gradient.mp4",
              poster: "/case-studies/multimodal-search/mmsearch-hero-gradient-poster.jpg",
            },
            chips: ["Text", "Image", "Tag", "Caption"],
          },
          {
            kicker: "EMBEDDING LAYER",
            title: "CLIP makes visual assets searchable",
            summary:
              "Text, image, tags, and captions are projected into one semantic space, turning file management into visual discovery.",
            visual: "mm-embedding",
            chips: ["CLIP", "Vector Search", "Metadata"],
          },
          {
            kicker: "CLOUD SYSTEM",
            title: "GPU batch and cloud search split cleanly",
            summary:
              "GKE handles long GPU embedding jobs; Cloud Run serves user search; BigQuery and Vertex connect semantics with metadata.",
            visual: "mm-architecture",
            media: {
              type: "image",
              src: "/diagrams/multimodal-search.svg",
              alt: "Multimodal search cloud architecture",
            },
          },
          {
            kicker: "RESULT",
            title: "One-second multimodal discovery",
            summary:
              "One million images were indexed into a shared platform with warm search around one second for multiple internal teams.",
            visual: "mm-result",
            media: {
              type: "video",
              src: "/case-studies/multimodal-search/mmsearch-hero-gradient.mp4",
              poster: "/case-studies/multimodal-search/mmsearch-hero-gradient-poster.jpg",
            },
            metrics: [
              { value: "1M", label: "images indexed" },
              { value: "~1s", label: "warm search" },
              { value: "100+ FPS", label: "embedding throughput" },
            ],
          },
        ],
        "robotic-video-intelligence": [
          {
            kicker: "WHY IT MATTERS",
            title: "POCs need a shared operating system",
            summary:
              "Devices, algorithms, operators, and customer evidence had to be connected. The missing piece was not another detector, but a repeatable field loop.",
            visual: "video-context",
            media: {
              type: "image",
              src: "/case-studies/video-intelligence/operations-loop.svg",
              alt: "Video operations loop",
            },
          },
          {
            kicker: "TASK WORKFLOW",
            title: "The task matters more than the model call",
            summary:
              "Stream-to-stream, file-to-stream, and file-to-file modes unify live demos, historical replay, and regression testing.",
            visual: "video-workflow",
            chips: ["Stream → Stream", "File → Stream", "File → File"],
          },
          {
            kicker: "SYSTEM LAYERS",
            title: "Media, GPU, and evidence layers",
            summary:
              "GStreamer owns media, GPU services own inference, and the event layer persists snapshots, timestamps, and frame-level results.",
            visual: "video-system",
            media: {
              type: "image",
              src: "/diagrams/video-platform.svg",
              alt: "Video intelligence platform architecture",
            },
          },
          {
            kicker: "RESULT",
            title: "Field demos become repeatable",
            summary:
              "The platform folded algorithm integration, customer testing, and field demos into one workspace with less repeated setup and scattered feedback.",
