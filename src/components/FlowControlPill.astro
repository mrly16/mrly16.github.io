---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import ViewerIcon from "./ViewerIcon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const first = projects[0];
const pillTitles: Record<string, { en: [string, string]; zh: [string, string] }> = {
  "vision-agent": { en: ["Eyes with", "intent"], zh: ["有意图的", "眼睛"] },
  "robotic-video-intelligence": { en: ["Cameras become", "memory"], zh: ["镜头成为", "记忆"] },
  "multimodal-asset-search": { en: ["Search by", "feeling"], zh: ["以感觉", "搜寻"] },
  "lookx-generative-ai": { en: ["Images learn", "to dream"], zh: ["图像开始", "做梦"] },
  "floor-plan-reconstruction": { en: ["Pixels become", "rooms"], zh: ["像素长成", "房间"] },
};
const pillThumbs: Record<string, string> = {
  "robotic-video-intelligence": "/case-studies/pill-thumbs/videointelligence.png",
  "floor-plan-reconstruction": "/case-studies/pill-thumbs/floorplan.png",
  "lookx-generative-ai": "/case-studies/pill-thumbs/lookx.png",
  "multimodal-asset-search": "/case-studies/pill-thumbs/mmsearch.png",
};
const firstPillTitleLines =
  first && pillTitles[first.data.slug]
    ? pillTitles[first.data.slug][locale]
    : [first?.data.sessionHeadline ?? first?.data.title ?? "", ""];
const firstPillThumb = first ? (pillThumbs[first.data.slug] ?? first.data.diagram) : "";
const copy =
  locale === "zh"
    ? {
        previous: "上一章节",
        next: "下一章节",
        nextChannel: "下一个项目",
        previousChannel: "上一个项目",
      }
    : {
        previous: "Previous episode",
        next: "Next episode",
        nextChannel: "Next project",
        previousChannel: "Previous project",
      };
---

<div class="flow-pill-shell" data-flow-pill-shell>
  <div class="flow-pill" data-flow-pill>
    <div class="flow-pill-transport">
      <button type="button" data-episode-previous aria-label={copy.previous}>
        <ViewerIcon name="previous" size={16} />
      </button>
      <button type="button" data-episode-next aria-label={copy.next}>
        <ViewerIcon name="next" size={16} />
      </button>
    </div>

    <div class={`flow-pill-channel accent-${first?.data.accent ?? "terracotta"} project-${first?.data.slug ?? ""}`} data-pill-channel>
      <div class="flow-pill-channel-thumb">
        <canvas
          data-viewer-thumbnail
          data-viewer-thumbnail-slug={first?.data.slug ?? ""}
          aria-hidden="true"
        ></canvas>
      </div>
      <div class="flow-pill-channel-copy">
        <button type="button" data-project-next aria-label={copy.nextChannel}>
          <ViewerIcon name="up" size={18} />
        </button>
        <strong data-viewer-title>
          {firstPillTitleLines.map((line) => <span>{line}</span>)}
        </strong>
        <button type="button" data-project-previous aria-label={copy.previousChannel}>
          <ViewerIcon name="down" size={18} />
        </button>
      </div>
    </div>

    <div class="flow-pill-page-indicator" data-page-indicator>
      <span data-page-current>01</span>
      <span aria-hidden="true">/</span>
      <span data-page-total>04</span>
    </div>
  </div>
</div>

<script>
  import { NeatGradient } from "@firecms/neat";

  const thumbnailCanvas = document.querySelector("[data-viewer-thumbnail]");
  const neatLicenseKey = import.meta.env.PUBLIC_NEAT_LICENSE_KEY;

  const pillPalettes: Record<string, string[]> = {
    "vision-agent": ["#6D3BFF", "#17E7FF", "#0B1738", "#A8E6CF"],
    "robotic-video-intelligence": ["#A8E6CF", "#17E7FF", "#143B2F", "#FFC858"],
    "multimodal-asset-search": ["#FFC858", "#17E7FF", "#003FFF", "#FF5373"],
    "lookx-generative-ai": ["#FF5373", "#6D3BFF", "#2B0837", "#FFC858"],
    "floor-plan-reconstruction": ["#FFC858", "#A8E6CF", "#5C3712", "#6D3BFF"],
  };

  const toNeatColors = (colors: string[]) => [
    ...colors.map((color) => ({ color, enabled: true })),
    { color: "#f5e1e5", enabled: false },
    { color: "#A8E6CF", enabled: false },
  ];

  if (thumbnailCanvas instanceof HTMLCanvasElement) {
    try {
      const initialSlug = thumbnailCanvas.dataset.viewerThumbnailSlug ?? "vision-agent";
      const gradient = new NeatGradient({
        ref: thumbnailCanvas,
        ...(neatLicenseKey ? { licenseKey: neatLicenseKey } : {}),
        colors: toNeatColors(pillPalettes[initialSlug] ?? pillPalettes["vision-agent"]),
        speed: 2,
        horizontalPressure: 2,
        verticalPressure: 5,
        waveFrequencyX: 2,
        waveFrequencyY: 2,
        waveAmplitude: 5,
        shadows: 10,
        highlights: 8,
        colorBrightness: 1,
        colorSaturation: 10,
        wireframe: true,
        colorBlending: 6,
        backgroundColor: "#003FFF",
        backgroundAlpha: 1,
        grainScale: 0,
        grainSparsity: 0,
        grainIntensity: 0,
        grainSpeed: 0,
        resolution: 0.95,
        yOffset: 0,
        yOffsetWaveMultiplier: 3.5,
        yOffsetColorMultiplier: 3.5,
        yOffsetFlowMultiplier: 3.5,
        flowDistortionA: 0.4,
        flowDistortionB: 3,
        flowScale: 3.3,
        flowEase: 0.53,
        flowEnabled: false,
        enableProceduralTexture: false,
        transparentTextureVoid: false,
        textureVoidLikelihood: 0.06,
        textureVoidWidthMin: 10,
        textureVoidWidthMax: 500,
        textureBandDensity: 0.8,
        textureColorBlending: 0.06,
        textureSeed: 333,
        textureEase: 0.6,
        proceduralBackgroundColor: "#003FFF",
        textureShapeTriangles: 20,
        textureShapeCircles: 15,
        textureShapeBars: 15,
        textureShapeSquiggles: 10,
        domainWarpEnabled: false,
        domainWarpIntensity: 0,
        domainWarpScale: 3,
        vignetteIntensity: 0,
        vignetteRadius: 0.8,
        fresnelEnabled: false,
        fresnelPower: 2,
        fresnelIntensity: 0.5,
        fresnelColor: "#FFFFFF",
        iridescenceEnabled: false,
        iridescenceIntensity: 0.5,
        iridescenceSpeed: 1,
        bloomIntensity: 0,
        bloomThreshold: 0.7,
        chromaticAberration: 0,
        shapeType: "plane",
        shapeRotationX: 0,
        shapeRotationY: 0,
        shapeRotationZ: 0,
        shapeAutoRotateSpeedX: 0,
        shapeAutoRotateSpeedY: 0,
        sphereRadius: 15,
        torusRadius: 15,
        torusTube: 5,
        cylinderRadius: 10,
        cylinderHeight: 40,
        planeBend: 0,
        planeTwist: 0,
        silhouetteFade: 0.25,
        cylinderFade: 0.08,
        ribbonFade: 0.05,
        flatShading: true,
        cameraLock: true,
        cameraX: 0,
        cameraY: 0,
        cameraZ: 0,
        cameraRotationX: 0,
        cameraRotationY: 0,
        cameraRotationZ: 0,
        cameraZoom: 1,
      });

      const setPalette = (slug: string) => {
        if (slug in pillPalettes) gradient.colors = toNeatColors(pillPalettes[slug]);
      };

      window.addEventListener("portfolio:project-change", (event: Event) => {
        if (!(event instanceof CustomEvent)) return;
        const slug = event.detail?.slug;
        if (typeof slug === "string") setPalette(slug);
      });

      const observer = new MutationObserver(() => {
        const slug = thumbnailCanvas.dataset.viewerThumbnailSlug;
        if (slug) setPalette(slug);
      });
      observer.observe(thumbnailCanvas, { attributes: true, attributeFilter: ["data-viewer-thumbnail-slug"] });

      window.addEventListener(
        "pagehide",
        () => {
          observer.disconnect();
          gradient.destroy();
        },
        { once: true },
      );
    } catch {
      thumbnailCanvas.hidden = true;
    }
  }
</script>
