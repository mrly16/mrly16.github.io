---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import ViewerIcon from "./ViewerIcon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const first = projects[0];
const pillTitles: Record<string, { en: string[]; zh: string[] }> = {
  "vision-agent": { en: ["Agent"], zh: ["智能体"] },
  "robotic-video-intelligence": { en: ["FDE Tool"], zh: ["FDE 工具"] },
  "multimodal-asset-search": { en: ["Cloud Infra"], zh: ["云基础设施"] },
  "lookx-generative-ai": { en: ["AI Product"], zh: ["AI 产品"] },
  "floor-plan-reconstruction": { en: ["Algorithm"], zh: ["算法"] },
};
const pillThumbs: Record<string, string> = {
  "vision-agent": "/case-studies/pill-thumbs/vision-agent-motion.png",
  "robotic-video-intelligence": "/case-studies/pill-thumbs/video-intelligence-motion.png",
  "multimodal-asset-search": "/case-studies/pill-thumbs/mmsearch-motion.png",
  "lookx-generative-ai": "/case-studies/pill-thumbs/lookx-motion.png",
  "floor-plan-reconstruction": "/case-studies/pill-thumbs/floorplan-motion.png",
};
const firstPillTitleLines =
  first && pillTitles[first.data.slug]
    ? pillTitles[first.data.slug][locale]
    : [first?.data.sessionHeadline ?? first?.data.title ?? ""];
const firstPillThumb =
  first && pillThumbs[first.data.slug] ? pillThumbs[first.data.slug] : first?.data.diagram;
const copy =
  locale === "zh"
    ? {
        previous: "上一章节",
        next: "下一章节",
        fullscreen: "全屏显示",
        exitFullscreen: "退出全屏",
	        nextChannel: "下一个项目",
	        previousChannel: "上一个项目",
	        backToSessions: "返回项目展映",
	      }
	    : {
	        previous: "Previous episode",
	        next: "Next episode",
	        fullscreen: "Full screen",
	        exitFullscreen: "Exit full screen",
	        nextChannel: "Next project",
	        previousChannel: "Previous project",
	        backToSessions: "Back to carousel",
	      };
---

<div class="flow-pill-shell" data-flow-pill-shell>
  <div class="flow-pill" data-flow-pill>
    <div class="flow-pill-transport">
      <button type="button" data-episode-previous aria-label={copy.previous}>
        <ViewerIcon name="previous" size={16} />
      </button>
      <button type="button" data-episode-next aria-label={copy.next}>
        <ViewerIcon name="next" size={16} />
      </button>
      <button
        type="button"
        data-viewer-fullscreen
        aria-label={copy.fullscreen}
        data-fullscreen-label={copy.fullscreen}
        data-exit-fullscreen-label={copy.exitFullscreen}
      >
        <ViewerIcon name="fullscreen" size={16} />
      </button>
    </div>

    <div class={`flow-pill-channel accent-${first?.data.accent ?? "terracotta"} project-${first?.data.slug ?? ""}`} data-pill-channel>
	      <button
	        type="button"
	        class="flow-pill-channel-thumb"
	        style={firstPillThumb ? `--viewer-thumb-image: url("${firstPillThumb}")` : undefined}
	        data-viewer-carousel-return
	        aria-label={copy.backToSessions}
	      >
	        <div
	          data-viewer-thumbnail
	          data-viewer-thumbnail-slug={first?.data.slug ?? ""}
	          aria-hidden="true"
	        ></div>
	        <span class="flow-pill-thumb-return" aria-hidden="true">
	          <span class="flow-pill-thumb-return-index"></span>
	          <span class="flow-pill-thumb-return-stage"></span>
	          <span class="flow-pill-thumb-return-copy"></span>
	          <span class="flow-pill-thumb-return-arrow">
	            <ViewerIcon name="undo" size={18} />
	          </span>
	        </span>
	      </button>
      <div class="flow-pill-channel-copy">
        <button type="button" data-project-next aria-label={copy.nextChannel}>
          <ViewerIcon name="up" size={18} />
        </button>
        <strong data-viewer-title>
          {firstPillTitleLines.filter(Boolean).map((line) => <span>{line}</span>)}
        </strong>
        <button type="button" data-project-previous aria-label={copy.previousChannel}>
          <ViewerIcon name="down" size={18} />
        </button>
      </div>
    </div>

    <div class="flow-pill-page-indicator" data-page-indicator>
      <span data-page-current>01</span>
      <span aria-hidden="true">/</span>
      <span data-page-total>04</span>
    </div>
  </div>
</div>
