---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../lib/i18n";
import ViewerIcon from "./ViewerIcon.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
}

const { projects, locale } = Astro.props;
const first = projects[0];
const pillTitles: Record<string, { en: [string, string]; zh: [string, string] }> = {
  "vision-agent": { en: ["Eyes with", "intent"], zh: ["有意图的", "眼睛"] },
  "robotic-video-intelligence": { en: ["Cameras become", "memory"], zh: ["镜头成为", "记忆"] },
  "multimodal-asset-search": { en: ["Search by", "feeling"], zh: ["以感觉", "搜寻"] },
  "lookx-generative-ai": { en: ["Images learn", "to dream"], zh: ["图像开始", "做梦"] },
  "floor-plan-reconstruction": { en: ["Pixels become", "rooms"], zh: ["像素长成", "房间"] },
};
const firstPillTitleLines =
  first && pillTitles[first.data.slug]
    ? pillTitles[first.data.slug][locale]
    : [first?.data.sessionHeadline ?? first?.data.title ?? "", ""];
const copy =
  locale === "zh"
    ? {
        previous: "上一章节",
        next: "下一章节",
        nextChannel: "下一个项目",
        previousChannel: "上一个项目",
      }
    : {
        previous: "Previous episode",
        next: "Next episode",
        nextChannel: "Next project",
        previousChannel: "Previous project",
      };
---

<div class="flow-pill-shell" data-flow-pill-shell>
  <div class="flow-pill" data-flow-pill>
    <div class="flow-pill-transport">
      <button type="button" data-episode-previous aria-label={copy.previous}>
        <ViewerIcon name="previous" size={16} />
      </button>
      <button type="button" data-episode-next aria-label={copy.next}>
        <ViewerIcon name="next" size={16} />
      </button>
    </div>

    <div class={`flow-pill-channel accent-${first?.data.accent ?? "terracotta"} project-${first?.data.slug ?? ""}`} data-pill-channel>
      <div class="flow-pill-channel-thumb">
        <div
          data-viewer-thumbnail
          data-viewer-thumbnail-slug={first?.data.slug ?? ""}
          aria-hidden="true"
        ></div>
      </div>
      <div class="flow-pill-channel-copy">
        <button type="button" data-project-next aria-label={copy.nextChannel}>
          <ViewerIcon name="up" size={18} />
        </button>
        <strong data-viewer-title>
          {firstPillTitleLines.map((line) => <span>{line}</span>)}
        </strong>
        <button type="button" data-project-previous aria-label={copy.previousChannel}>
          <ViewerIcon name="down" size={18} />
        </button>
      </div>
    </div>

    <div class="flow-pill-page-indicator" data-page-indicator>
      <span data-page-current>01</span>
      <span aria-hidden="true">/</span>
      <span data-page-total>04</span>
    </div>
  </div>
</div>
