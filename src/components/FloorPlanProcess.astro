---
import processData from "../data/floor-plan-process.json";

interface Props {
  alt: string;
}

const { alt } = Astro.props;
---

<div class="floor-process" data-floor-process role="img" aria-label={alt}>
  <svg viewBox="0 0 800 600" aria-hidden="true">
    <defs>
      <filter id="floor-process-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="5" stdDeviation="7" flood-opacity="0.2" />
      </filter>
      <linearGradient id="floor-process-scan" x1="0" x2="1">
        <stop offset="0" stop-color="#d46d56" stop-opacity="0" />
        <stop offset="0.5" stop-color="#d46d56" stop-opacity="0.9" />
        <stop offset="1" stop-color="#d46d56" stop-opacity="0" />
      </linearGradient>
    </defs>

    <rect class="floor-process-paper" x="84" y="24" width="632" height="552" rx="20" />
    <image
      class="floor-process-raster"
      href="/case-studies/floor-plan/process-raster.png"
      x="0"
      y="0"
      width="800"
      height="600"
      preserveAspectRatio="xMidYMid meet"
    />

    <g class="floor-process-boundaries">
      {processData.edges.map((edge, index) => (
        <line
          x1={edge.x1}
          y1={edge.y1}
          x2={edge.x2}
          y2={edge.y2}
          pathLength="1"
          style={`--edge-index:${index};--edge-length:${edge.length}`}
        />
      ))}
    </g>

    <g class="floor-process-graph">
      {processData.edges.map((edge, index) => (
        <line
          x1={edge.x1}
          y1={edge.y1}
          x2={edge.x2}
          y2={edge.y2}
          pathLength="1"
          style={`--edge-index:${index};--edge-length:${edge.length}`}
        />
      ))}
      {processData.nodes.map((node, index) => (
        <g
          class="floor-process-node"
          transform={`translate(${node.x} ${node.y})`}
          style={`--node-index:${index}`}
        >
          <g class="node-lock">
            <circle class="node-ring" r="8.5" />
            <circle class="node-core" r="4.2" />
          </g>
        </g>
      ))}
    </g>

    <g class="floor-process-cursor">
      <line x1="250" y1="0" x2="250" y2="600" />
      <circle cx="250" cy="326" r="9" />
    </g>
  </svg>

</div>

<style>
  .floor-process {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: #171a18;
    background:
      radial-gradient(circle at 50% 43%, rgba(238, 231, 214, 0.98), rgba(215, 207, 190, 0.9)),
      #ddd5c4;
  }

  .floor-process svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .floor-process-paper {
    fill: rgba(255, 253, 248, 0.72);
    stroke: rgba(34, 37, 34, 0.13);
    filter: url("#floor-process-shadow");
  }

  .floor-process-raster {
    opacity: 0.94;
    transform-origin: center;
    animation: raster-settle 12s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .floor-process-boundaries line,
  .floor-process-graph line {
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .floor-process-boundaries line {
    stroke: #171a18;
    stroke-width: 5.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: boundary-draw 12s cubic-bezier(0.55, 0, 0.3, 1) infinite;
    animation-delay: calc(var(--edge-index) * 18ms);
  }

  .floor-process-graph line {
    stroke: #d6634c;
    stroke-width: 4.2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: graph-draw 12s cubic-bezier(0.55, 0, 0.3, 1) infinite;
    animation-delay: calc(var(--edge-index) * 16ms);
  }

  .floor-process-node {
    opacity: 0;
    animation: node-visible 12s linear infinite;
    animation-delay: calc(var(--node-index) * 18ms);
  }

  .node-lock {
    transform-box: fill-box;
    transform-origin: center;
    animation: node-lock 12s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    animation-delay: calc(var(--node-index) * 18ms);
  }

  .node-ring {
    fill: rgba(255, 253, 248, 0.94);
    stroke: #204e57;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .node-core {
    fill: #204e57;
  }

  .floor-process-cursor {
    opacity: 0;
    animation: scan-pass 12s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .floor-process-cursor line {
    stroke: url("#floor-process-scan");
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  .floor-process-cursor circle {
    fill: #fffdf8;
    stroke: #d6634c;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  @keyframes raster-settle {
    0%,
    8% {
      opacity: 0.98;
      filter: saturate(1);
      transform: scale(1.025);
    }
    24%,
    100% {
      opacity: 0.28;
      filter: grayscale(0.75) contrast(0.92);
      transform: scale(1);
    }
    78%,
    90% {
      opacity: 0.2;
    }
  }

  @keyframes boundary-draw {
    0%,
    11% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    27%,
    72% {
      stroke-dashoffset: 0;
      opacity: 0.64;
    }
    86%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  @keyframes graph-draw {
    0%,
    35% {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    55%,
    88% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  @keyframes node-visible {
    0%,
    40% {
      opacity: 0;
    }
    52%,
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes node-lock {
    0%,
    40% {
      transform: translate(7px, -5px) scale(0.4);
    }
    52%,
    88% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(0, 0) scale(0.8);
    }
  }

  @keyframes scan-pass {
    0%,
    12% {
      opacity: 0;
      transform: translateX(-190px);
    }
    16% {
      opacity: 0.85;
    }
    40% {
      opacity: 0.85;
      transform: translateX(360px);
    }
    44%,
    100% {
      opacity: 0;
      transform: translateX(360px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floor-process-raster {
      opacity: 0.24;
      filter: grayscale(0.7);
      animation: none;
    }

    .floor-process-boundaries line,
    .floor-process-graph line,
    .floor-process-node,
    .node-lock {
      opacity: 1;
      stroke-dashoffset: 0;
      transform: none;
      animation: none;
    }

    .floor-process-cursor {
      display: none;
    }
  }
</style>
