---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | Liangyi Murong"
  description="Applied AI engineer and technical leader with experience across computer vision, generative AI, spatial computing, cloud platforms, and customer delivery."
  locale="en"
  className="identity-page"
>
  <section class="identity-hero-page">
    <header class="page-intro identity-intro">
      <div class="identity-hero-copy">
        <h1>Since 2019, working at tech startups has made me comfortable with ambiguity and complexity: making clear decisions, building and shipping with limited resources, and explaining value to different stakeholders.</h1>
        <a class="identity-email-cta" href="mailto:markmoyung131@gmail.com">Email me</a>
      </div>
      <div class="identity-career-strip" aria-label="Career timeline summary">
        <div class="identity-career-node">
          <b aria-hidden="true"></b>
          <span>2019</span>
          <strong>Yun Zhenxin</strong>
        </div>
        <div class="identity-career-node">
          <b aria-hidden="true"></b>
          <span>2020</span>
          <strong>Xkool</strong>
        </div>
        <div class="identity-career-node">
          <b aria-hidden="true"></b>
          <span>2025</span>
          <strong>Avant Robotics</strong>
        </div>
        <div class="identity-career-node">
          <b aria-hidden="true"></b>
          <span>now</span>
        </div>
      </div>
    </header>

    <aside class="about-grid identity-panel" aria-label="Experience and education">
      <div class="timeline-group">
        <p class="eyebrow">Education</p>
        <dl class="timeline">
          <div>
            <dt>University of Michigan</dt>
            <dd>Master of Information Science</dd>
          </div>
          <div>
            <dt>South China University of Technology</dt>
            <dd>Bachelor of Architectural Design</dd>
          </div>
        </dl>
      </div>

      <div class="timeline-group">
        <p class="eyebrow">Experience</p>
        <dl class="timeline">
          <div>
            <dt>Avant Robotics · Autel Group</dt>
            <dd>
              Systems Engineer / Senior AI Engineer · 2025–present<br />
              Robotic inspection, video intelligence, and agent.
            </dd>
          </div>
          <div>
            <dt>XKool Technology</dt>
            <dd>
              Lead R&amp;D Scientist · 2020–2025<br />
              Algorithms, generative AI, and AI native products.
            </dd>
          </div>
          <div>
            <dt>Yun Zhenxin Technology</dt>
            <dd>
              Machine Learning Engineer · 2019–2020<br />
              Big data, fraud detection, machine learning.
            </dd>
          </div>
        </dl>
      </div>
    </aside>
  </section>

  <script is:inline>
    const validAboutProjectSlugs = new Set([
      "vision-agent",
      "robotic-video-intelligence",
      "multimodal-asset-search",
      "lookx-generative-ai",
      "floor-plan-reconstruction",
    ]);
    try {
      const lastProjectSlug = window.localStorage.getItem("portfolio:lastProjectSlug");
      if (lastProjectSlug && validAboutProjectSlugs.has(lastProjectSlug)) {
        document.body.dataset.lastProject = lastProjectSlug;
      }
    } catch {
      // Keep the default about gradient when storage is unavailable.
    }
  </script>
</BaseLayout>
